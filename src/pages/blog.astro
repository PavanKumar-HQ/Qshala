---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const POSTS = [
  {
    slug: "why-rote-learning-kills-curiosity",
    title: "Why Rote Learning Kills Curiosity (And How to Fix It)",
    category: "Pedagogy",
    readTime: "5 min read",
    summary: "Standard GK worksheets ask children to memorize facts without asking why. We explore socratic dialogue methods that unlock original thinking.",
    color: "#30B2E7",
    bg: "bg-[#E8F6FD]"
  },
  {
    slug: "curious-dinner-table",
    title: "How to Build a 'Curious Dinner Table' for Your Kids",
    category: "Parenting",
    readTime: "4 min read",
    summary: "Three simple question prompts and game mechanics that swap screen time for active discussion during family dinners.",
    color: "#75B543",
    bg: "bg-[#EDF7E5]"
  },
  {
    slug: "gamification-modern-corporate-learning",
    title: "Gamification: The Secret Weapon of Modern Corporate L&D",
    category: "Workplace Culture",
    readTime: "6 min read",
    summary: "How leading startups use live interactive buzzers and case-study tournaments to boost cross-team engagement by over 90%.",
    color: "#FDB913",
    bg: "bg-[#FFF8E1]"
  },
  {
    slug: "socratic-mindset-future-ready-kids",
    title: "How Socratic Questioning Builds Future-Ready Mindsets in Children",
    category: "Cognitive Growth",
    readTime: "5 min read",
    summary: "In an era of instant answers, the skill of the 21st century is framing the right question. Learn how socratic loops build resilient problem solvers.",
    color: "#30B2E7",
    bg: "bg-[#E8F6FD]"
  },
  {
    slug: "ai-and-curiosity-asking-right-questions",
    title: "AI & Curiosity: Teaching Children How to Ask the Right Questions",
    category: "AI & Tech",
    readTime: "6 min read",
    summary: "Large Language Models give immediate answers. Here is why prompt drafting and critical curiosity are the essential skills for young minds today.",
    color: "#75B543",
    bg: "bg-[#EDF7E5]"
  },
  {
    slug: "daily-news-quizzing-critical-thinking",
    title: "The Power of Daily News Quizzing for School Students",
    category: "Current Affairs",
    readTime: "4 min read",
    summary: "How reading current events through interactive quiz questions turns passive headlines into active global awareness.",
    color: "#FDB913",
    bg: "bg-[#FFF8E1]"
  }
];
---

<BaseLayout title="Curiosity Blog & Articles | QShala">
  <Navbar />

  <main class="flex-grow pt-28 pb-24 overflow-x-hidden bg-[#FFFDF5] w-full">
    <div class="w-full px-4 sm:px-8 md:px-12 space-y-16">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4 pt-4">
        <span class="px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase border border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] font-heading">
          QShala Magazine
        </span>
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 font-heading leading-tight">
          Exploring Curiosity.
        </h1>
        <p class="text-slate-700 text-base sm:text-lg font-semibold max-w-2xl mx-auto leading-relaxed">
          Read our latest insights on socratic education, modern cognitive development, AI literacy, and active parenting.
        </p>
      </div>

      <!-- Mascot Buddy -->
      <div class="flex justify-center">
        <QTMascot client:visible variant="reading" size="lg" badgeText="Quiet Time!" />
      </div>

      <!-- Articles Grid (6 SEO Blog Posts with Pill CTA Button) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-full">
        {POSTS.map(post => (
          <article class={`rounded-3xl p-8 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] ${post.bg} flex flex-col justify-between space-y-6 group hover:-translate-y-1 transition-all duration-300 w-full`}>
            <div class="space-y-4">
              <div class="flex justify-between items-center text-xs font-black uppercase text-slate-500 font-heading">
                <span class="px-3 py-1 rounded-full bg-white text-slate-900 border border-black shadow-sm">{post.category}</span>
                <span>{post.readTime}</span>
              </div>
              <a href={`/blog/${post.slug}`}>
                <h3 class="text-2xl font-black font-heading group-hover:text-[#30B2E7] transition-colors leading-snug text-slate-900">
                  {post.title}
                </h3>
              </a>
              <p class="text-slate-800 text-sm font-semibold leading-relaxed">
                {post.summary}
              </p>
            </div>
            
            {/* Pill CTA Button (Matching Requested Button Style) */}
            <div class="pt-4 border-t border-slate-900/10">
              <a 
                href={`/blog/${post.slug}`} 
                class="px-5 py-2.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black border-2 border-slate-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-0.5 transition-all text-xs font-heading uppercase flex items-center justify-between group-hover:bg-amber-400"
              >
                <span>Read Article</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Subscribe Form Card -->
      <div class="bg-white rounded-3xl p-8 md:p-12 border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] text-center max-w-4xl mx-auto space-y-6">
        <h2 class="text-3xl font-black font-heading text-slate-900">Get the Weekly &apos;Curiosity Digest&apos;</h2>
        <p class="text-slate-700 font-semibold max-w-xl mx-auto text-sm">
          Join 12,000+ parents and educators who receive 5 interesting facts and 1 brain-teaser question every Sunday.
        </p>
        <form action="mailto:qshala@walnuts.co.in" method="post" class="flex flex-col sm:flex-row justify-center gap-3 max-w-md mx-auto">
          <input type="email" placeholder="Your Email Address" required class="px-5 py-3 rounded-full border-2 border-black bg-[#FFFDF5] font-semibold text-sm w-full focus:outline-none text-slate-900" />
          <button type="submit" class="px-6 py-3 rounded-full bg-[#75B543] hover:bg-[#8CD354] text-white border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] transition-all font-black text-sm whitespace-nowrap font-heading">
            Subscribe &rarr;
          </button>
        </form>
      </div>

    </div>
  </main>

  <Footer />
</BaseLayout>
