---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const POSTS = [
  {
    slug: "why-rote-learning-kills-curiosity",
    title: "Why Rote Learning Kills Curiosity (And How to Fix It)",
    category: "Pedagogy",
    readTime: "5 min read",
    summary: "Standard GK worksheets ask children to memorize facts without asking why. We explore socratic dialogue methods that unlock original thinking.",
    color: "#30B2E7",
    bg: "bg-[#E8F6FD]"
  },
  {
    slug: "curious-dinner-table",
    title: "How to Build a 'Curious Dinner Table' for Your Kids",
    category: "Parenting",
    readTime: "4 min read",
    summary: "Three simple question prompts and game mechanics that swap screen time for active discussion during family dinners.",
    color: "#75B543",
    bg: "bg-[#EDF7E5]"
  },
  {
    slug: "gamification-modern-corporate-learning",
    title: "Gamification: The Secret Weapon of Modern Corporate L&D",
    category: "Workplace Culture",
    readTime: "6 min read",
    summary: "How leading startups use live interactive buzzers and case-study tournaments to boost cross-team engagement by over 90%.",
    color: "#FDB913",
    bg: "bg-[#FFF8E1]"
  }
];
---

<BaseLayout title="Curiosity Blog & Articles | QShala">
  <Navbar />
  <main class="flex-grow pt-32 pb-24 px-6 bg-[#FFFDF5]">
    <div class="max-w-7xl mx-auto space-y-16">
      
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase border border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] font-heading">
          QShala Magazine
        </span>
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 mt-4 font-heading leading-tight">
          Exploring Curiosity.
        </h1>
        <p class="text-slate-700 text-lg font-semibold max-w-2xl mx-auto leading-relaxed">
          Read our latest insights on socratic education, modern cognitive development, and active parenting.
        </p>
      </div>

      <!-- Mascot Buddy -->
      <div class="flex justify-center">
        <QTMascot client:visible variant="reading" size="lg" badgeText="Quiet Time!" />
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {POSTS.map(post => (
          <article class={`rounded-3xl p-8 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] ${post.bg} flex flex-col justify-between space-y-6 group hover:-translate-y-1 transition-transform`}>
            <div>
              <div class="flex justify-between items-center text-xs font-black uppercase text-slate-500">
                <span>{post.category}</span>
                <span>{post.readTime}</span>
              </div>
              <a href={`/blog/${post.slug}`}>
                <h3 class="text-2xl font-black font-heading mt-4 group-hover:text-[#30B2E7] transition-colors leading-snug">
                  {post.title}
                </h3>
              </a>
              <p class="text-slate-800 text-sm font-semibold leading-relaxed mt-3">
                {post.summary}
              </p>
            </div>
            <div>
              <a href={`/blog/${post.slug}`} class="inline-flex items-center gap-2 text-xs font-black uppercase font-heading text-slate-900 hover:underline">
                Read Article →
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Subscribe Form Card -->
      <div class="bg-white rounded-3xl p-8 md:p-12 border-2 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] text-center max-w-4xl mx-auto space-y-6">
        <h2 class="text-3xl font-black font-heading">Get the Weekly 'Curiosity Digest'</h2>
        <p class="text-slate-700 font-semibold max-w-xl mx-auto text-sm">
          Join 12,000+ parents and educators who receive 5 interesting facts and 1 brain-teaser question every Sunday.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-3 max-w-md mx-auto">
          <input type="email" placeholder="Your Email Address" class="px-5 py-3 rounded-full border-2 border-black bg-[#FFFDF5] font-semibold text-sm w-full focus:outline-none" />
          <button class="px-6 py-3 rounded-full bg-[#75B543] hover:bg-[#8CD354] text-white border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] transition-all font-black text-sm whitespace-nowrap font-heading">
            Subscribe
          </button>
        </div>
      </div>

    </div>
  </main>
  <Footer />
</BaseLayout>
