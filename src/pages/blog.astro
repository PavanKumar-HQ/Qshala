---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';
import BlogShowcase from '../components/BlogShowcase';

const blogSchema = {
  "@type": "CollectionPage",
  "@id": "https://qshala.vercel.app/blog#collection",
  "name": "QShala Magazine, Articles & Event Coverage",
  "description": "Read insights on socratic education, school quiz clubs, quizmastering in India, corporate trivia, and view photo event reports from across India.",
  "publisher": {
    "@id": "https://qshala.vercel.app/#organization"
  }
};
---

<BaseLayout 
  title="Quriosity Magazine & Event Reports | Quizmaster in India & Bangalore Quizzing"
  description="Explore perspectives on socratic learning, child curiosity, corporate trivia, and comprehensive photo event reports from India's premier quizmasters."
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Magazine & Events", item: "/blog" }
  ]}
  schema={blogSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-28 pb-24 px-4 sm:px-8 max-w-7xl mx-auto space-y-16 bg-[#FFFDF5]">
    
    <!-- Page Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 pt-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
        QShala Magazine &amp; Live Reports
      </span>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 font-heading leading-tight">
          Exploring Quriosity.
        </h1>
        <div class="shrink-0 hidden sm:block">
          <QTMascot client:visible variant="reading" size="md" />
        </div>
      </div>
      
      <p class="text-slate-600 font-semibold text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Perspectives on Socratic education, cognitive growth, quizmastering in Bangalore and across India, plus photo reports from live championships.
      </p>
    </div>

    <!-- Interactive Blog & Event Reports Showcase -->
    <div class="w-full relative clear-both">
      <BlogShowcase client:load />
    </div>

    <!-- Newsletter Digest Card -->
    <section class="pt-10 pb-6 w-full relative clear-both">
      <div class="bg-[#F2FCE8] rounded-3xl p-8 md:p-12 border border-[#75B543]/25 shadow-sm text-center max-w-3xl mx-auto space-y-6 relative overflow-hidden">
        <div class="space-y-2">
          <span class="inline-block px-3.5 py-1 rounded-full bg-[#75B543] text-white font-black text-xs uppercase font-heading shadow-xs">
            Weekly Free Edition
          </span>
          <h2 class="text-2xl sm:text-3xl font-black font-heading text-slate-900 pt-1">
            Get the Weekly &apos;Quriosity Digest&apos;
          </h2>
          <p class="text-slate-700 font-semibold max-w-xl mx-auto text-sm sm:text-base">
            Join 12,000+ educators, parents, and quizzers who receive 5 fascinating real-world facts and 1 weekly brain-teaser every Sunday.
          </p>
        </div>
        
        <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" onsubmit="event.preventDefault();">
          <input 
            type="email" 
            placeholder="Enter your email address" 
            aria-label="Email address for Quriosity Digest"
            class="flex-grow px-5 py-3.5 rounded-full bg-white border border-slate-200 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#75B543] shadow-xs"
            required
          />
          <button 
            type="submit" 
            class="px-8 py-3.5 rounded-full bg-slate-900 hover:bg-[#75B543] text-white font-black text-xs uppercase tracking-wider font-heading transition-colors shrink-0 shadow-sm hover:shadow-md cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900"
          >
            Subscribe &rarr;
          </button>
        </form>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
