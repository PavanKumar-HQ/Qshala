---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const SERVICE_MODULES = [
  {
    id: "schools",
    typeParam: "school",
    title: "Schools",
    badge: "Academic Year & Custom Quizzes",
    description: "Empowering K-12 educational institutions with year-round weekly curiosity clubs, current affairs storytelling, and socratic learning integrated directly into school timetables. Beyond our full-year academic programs, we host high-energy inter-school quiz championships, science bees, and sports trivia leagues throughout the academic calendar.",
    highlights: ["Year-Round Curiosity Clubs", "Socratic Science & Civics", "Inter-School Quiz Tournaments", "Current Affairs Storytelling"],
    mascotVariant: "reading" as const,
    imageSrc: "https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=800&auto=format&fit=crop",
    imageAlt: "School students learning curiously in classroom",
    salesTeam: "School Academic & Sales Team"
  },
  {
    id: "colleges",
    typeParam: "college",
    title: "Colleges",
    badge: "Multi-Disciplinary Campus Quizzes",
    description: "Bringing high-octane quiz championships to top college campuses across India. We double down on application-based curiosity across diverse academic domains—from Law moot court trivia, Finance & Business case leagues, Literature & Arts fests, to STEM & Public Policy hackathons.",
    highlights: ["Law & Legal Trivia", "Finance & Economics Leagues", "Business & Strategy Fests", "Literature & Cultural Quizzes", "STEM & Policy Hackathons"],
    mascotVariant: "idea" as const,
    imageSrc: "https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=800&auto=format&fit=crop",
    imageAlt: "College students celebrating graduation and campus fest",
    salesTeam: "Higher Ed & Campus Sales Team"
  },
  {
    id: "companies",
    typeParam: "company",
    title: "Companies",
    badge: "Fortune 500 Corporate Engagement",
    description: "High-impact employee engagement and hybrid team bonding for global enterprises. We gamify brand history, company values, product onboarding, and leadership offsites for industry leaders including Flipkart, Wipro, TCS, Infosys, Google, HDFC Bank, Amazon, Microsoft, Byju's, Netflix, and Apple.",
    highlights: ["Flipkart", "Wipro", "TCS", "Infosys", "Google", "HDFC Bank", "Amazon", "Microsoft", "Netflix", "Byju's"],
    isNameDrop: true,
    mascotVariant: "professional" as const,
    imageSrc: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Corporate team collaborating during live event",
    salesTeam: "Corporate L&D & HR Sales Team"
  },
  {
    id: "communities",
    typeParam: "community",
    title: "Communities",
    badge: "Unconventional Venue Quizzes",
    description: "Curiosity doesn't just belong in classrooms or offices! We bring customized interactive quizzes to every community setting under the sun—from intimate wedding icebreakers, landmark birthday parties, and neighborhood housing societies, to large-scale public policy conventions and national finance summits.",
    highlights: ["Weddings 💍", "Birthday Parties 🎂", "Public Policy Conventions 📜", "Finance Summits 📈", "Housing Societies 🏡", "Alumni Reunions 🎓"],
    mascotVariant: "curious" as const,
    imageSrc: "https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Friends gathering happily at a community event",
    salesTeam: "Community & Special Events Team"
  },
  {
    id: "custom",
    typeParam: "custom",
    title: "HAVE SOMETHING ELSE IN MIND?",
    badge: "Custom Curiosity Experiences",
    description: "TELL US! QShala is founded on a pure, unbridled love for Quriosity. Whether it's a niche museum quest, a custom podcast quiz, a global virtual league, or a brand-new concept—we're happy to bring our love for learning anywhere!",
    highlights: ["Custom Concept Development", "Niche Topic Quizzes", "Virtual Global Leagues", "Museum & Museum Quests"],
    mascotVariant: "trophy" as const,
    imageSrc: "https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Team designing custom learning experience",
    salesTeam: "Special Experience & Custom Quiz Team"
  }
];
---

<BaseLayout title="Book a Quiz Now | QShala Offerings & Services">
  <Navbar />

  <main class="flex-grow pt-28 pb-24 overflow-x-hidden bg-[#FFFDF5]">

    <!-- Page Header -->
    <section class="py-12 relative">
      <div class="max-w-6xl mx-auto px-6 text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-slate-200 shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-[#FDB913] animate-ping"></span>
          <span class="text-xs font-black uppercase text-slate-800 tracking-wider font-heading">
            QShala Curiosity Services
          </span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading">
          Book a Quiz now!
        </h1>

        <p class="text-slate-600 font-semibold text-base sm:text-lg max-w-2xl mx-auto">
          Tailored curiosity experiences for schools, colleges, companies, communities, and custom celebrations. Click <span class="text-slate-900 font-black">"BOOK NOW!"</span> on any segment to connect directly with that dedicated sales team.
        </p>
      </div>
    </section>

    <!-- Services Modules Stack (Matching exact client brief & wireframe layout!) -->
    <section class="py-6 max-w-6xl mx-auto px-6 space-y-8">
      {SERVICE_MODULES.map((module) => (
        <div 
          id={module.id}
          class="bg-[#FFF8E1] rounded-3xl p-6 sm:p-8 md:p-10 border-2 border-slate-900 shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] grid grid-cols-1 lg:grid-cols-12 gap-8 items-center transition-all hover:shadow-[7px_7px_0px_0px_rgba(0,0,0,1)]"
        >
          <!-- Left Thumbnail Image (2-column layout matching brief) -->
          <div class="lg:col-span-4 relative group">
            <div class="overflow-hidden rounded-2xl border-2 border-slate-900 aspect-[4/3] bg-white shadow-sm">
              <img 
                src={module.imageSrc} 
                alt={module.imageAlt} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>

            <!-- Floating Mascot Tag -->
            <div class="absolute -top-3 -right-3 scale-90 bg-white p-2 rounded-2xl border-2 border-slate-900 shadow-sm">
              <QTMascot client:visible variant={module.mascotVariant} size="sm" />
            </div>
          </div>

          <!-- Right Content Area -->
          <div class="lg:col-span-8 flex flex-col justify-between h-full space-y-6">
            <div class="space-y-3">
              <!-- Category Badge & Handling Sales Team note -->
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="px-3 py-1 rounded-full bg-white text-slate-900 font-black text-xs uppercase border border-slate-900 font-heading">
                  {module.badge}
                </span>

                <span class="text-[11px] font-black uppercase text-slate-600 font-heading bg-amber-200/60 px-2.5 py-0.5 rounded-full border border-amber-300">
                  Routed to: {module.salesTeam}
                </span>
              </div>

              <!-- Module Title -->
              <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading tracking-tight">
                {module.title}
              </h2>

              <!-- Description Copy from Brief -->
              <p class="text-slate-800 text-sm sm:text-base font-semibold leading-relaxed">
                {module.description}
              </p>

              <!-- Highlights / Name Drops / Unconventional venue pills -->
              <div class="pt-2 flex flex-wrap gap-2">
                {module.highlights.map((item) => (
                  <span class={`px-3 py-1 rounded-xl text-xs font-black border border-slate-900 ${
                    module.isNameDrop 
                      ? 'bg-[#30B2E7] text-white shadow-sm' 
                      : 'bg-white text-slate-900 shadow-sm'
                  }`}>
                    {item}
                  </span>
                ))}
              </div>
            </div>

            <!-- Bottom CTA Button (Matching client's yellow "BOOK NOW!" button, linked to form with type parameter) -->
            <div class="pt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-t border-slate-900/10">
              <div class="text-xs font-bold text-slate-600">
                Direct booking line for <strong class="text-slate-900">{module.title}</strong> inquiries
              </div>

              <a
                href={`/book-a-quiz?type=${module.typeParam}`}
                class="px-8 py-3.5 rounded-xl bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-sm uppercase tracking-wider border-2 border-slate-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] font-heading transition-all inline-flex items-center justify-center gap-2 group shrink-0"
              >
                <span>BOOK NOW!</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </a>
            </div>

          </div>
        </div>
      ))}
    </section>

  </main>

  <Footer />
</BaseLayout>
