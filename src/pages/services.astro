---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const BRAND_PALETTE = [
  { bg: '#30B2E7', text: '#FFFFFF' }, // Qurious Sky
  { bg: '#FDB913', text: '#0F172A' }, // Joy of Quest
  { bg: '#75B543', text: '#FFFFFF' }, // Always Questioning
  { bg: '#9333EA', text: '#FFFFFF' }, // Purple
  { bg: '#EC4899', text: '#FFFFFF' }  // Pink
];

const SERVICE_MODULES = [
  {
    id: "schools",
    typeParam: "school",
    title: "Academic Year and Custom Quizzes",
    badge: "Schools",
    description: "Empowering K-12 educational institutions with year-round weekly quriosity clubs, current affairs storytelling, and socratic learning integrated directly into school timetables. Beyond our full-year academic programs, we host high-energy inter-school quiz championships, science bees, and sports trivia leagues throughout the academic calendar.",
    highlights: ["Year-Round Quriosity Clubs", "Socratic Science & Civics", "Inter-School Quiz Tournaments", "Current Affairs Storytelling"],
    mascotVariant: "reading" as const,
    imageSrc: "https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=800&auto=format&fit=crop",
    imageAlt: "School students learning curiously in classroom",
    salesTeam: "School Academic & Sales Team",
    color: "#30B2E7",
    bgTint: "#E8F6FD"
  },
  {
    id: "colleges",
    typeParam: "college",
    title: "Multi-Disciplinary Campus Quizzes",
    badge: "Colleges",
    description: "Bringing high-octane quiz championships to top college campuses across India. We double down on application-based quriosity across diverse academic domains—from Law moot court trivia, Finance & Business case leagues, Literature & Arts fests, to STEM & Public Policy hackathons.",
    highlights: ["Law & Legal Trivia", "Finance & Economics Leagues", "Business & Strategy Fests", "Literature & Cultural Quizzes", "STEM & Policy Hackathons"],
    mascotVariant: "idea" as const,
    imageSrc: "https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=800&auto=format&fit=crop",
    imageAlt: "College students celebrating graduation and campus fest",
    salesTeam: "Higher Ed & Campus Sales Team",
    color: "#FDB913",
    bgTint: "#FFF8E1"
  },
  {
    id: "companies",
    typeParam: "company",
    title: "Corporate Engagement",
    badge: "Companies",
    description: "High-impact employee engagement and hybrid team bonding for global enterprises. We gamify brand history, company values, product onboarding, and leadership offsites for industry leaders including Flipkart, Wipro, TCS, Infosys, Google, HDFC Bank, Amazon, Microsoft, Byju's, Netflix, and Apple.",
    highlights: ["Flipkart", "Wipro", "TCS", "Infosys", "Google", "HDFC Bank", "Amazon", "Microsoft", "Netflix", "Byju's"],
    isNameDrop: true,
    mascotVariant: "professional" as const,
    imageSrc: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Corporate team collaborating during live event",
    salesTeam: "Corporate L&D & HR Sales Team",
    color: "#75B543",
    bgTint: "#EDF7E5"
  },
  {
    id: "communities",
    typeParam: "community",
    title: "Community Engagement",
    badge: "Communities",
    description: "Quriosity doesn't just belong in classrooms or offices! We bring customized interactive quizzes to every community setting under the sun—from intimate wedding icebreakers, landmark birthday parties, and neighborhood housing societies, to large-scale public policy conventions and national finance summits.",
    highlights: ["Weddings", "Birthday Parties", "Public Policy Conventions", "Finance Summits", "Housing Societies", "Alumni Reunions"],
    mascotVariant: "curious" as const,
    imageSrc: "https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Friends gathering happily at a community event",
    salesTeam: "Community & Special Events Team",
    color: "#30B2E7",
    bgTint: "#E8F6FD"
  },
  {
    id: "custom",
    typeParam: "custom",
    title: "Custom Experiences",
    badge: "Custom",
    description: "TELL US! QShala is founded on a pure, unbridled love for Quriosity. Whether it's a niche museum quest, a custom podcast quiz, a global virtual league, or a brand-new concept—we're happy to bring our love for learning anywhere!",
    highlights: ["Custom Concept Development", "Niche Topic Quizzes", "Virtual Global Leagues", "Museum Quests"],
    mascotVariant: "trophy" as const,
    imageSrc: "https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Team designing custom learning experience",
    salesTeam: "Special Experience & Custom Quiz Team",
    color: "#FDB913",
    bgTint: "#FFF8E1"
  }
];
---

<BaseLayout title="Book a Quiz Now | QShala Offerings & Services">
  <Navbar />

  <main class="flex-grow pt-28 pb-24 overflow-x-hidden bg-[#FFFDF5] w-full">

    <!-- Page Header (Full Width Fit) -->
    <section class="py-8 w-full px-4 sm:px-8 md:px-12">
      <div class="w-full text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-slate-200 shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-[#FDB913] animate-ping"></span>
          <span class="text-xs font-black uppercase text-slate-800 tracking-wider font-heading">
            QShala Quriosity Services
          </span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading">
          Book a Quiz now!
        </h1>

        <p class="text-slate-600 font-semibold text-base sm:text-lg max-w-4xl mx-auto leading-relaxed">
          Tailored quriosity experiences for schools, colleges, companies, communities, and custom celebrations. Click <span class="text-slate-900 font-black">&ldquo;BOOK NOW!&rdquo;</span> on any segment to connect directly with that dedicated sales team.
        </p>
      </div>
    </section>

    <!-- Services Modules Stack (Full Page Width Fit w-full) -->
    <section class="py-4 w-full px-4 sm:px-8 md:px-12 space-y-12">
      {SERVICE_MODULES.map((module, idx) => {
        const isReversed = idx % 2 !== 0;
        return (
          <div 
            id={module.id}
            class="group p-8 sm:p-10 md:p-12 rounded-3xl transition-all duration-300 border-2 border-slate-900/10 hover:border-slate-900 shadow-sm hover:shadow-xl hover:-translate-y-1 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center w-full"
            style={`background-color: ${module.bgTint};`}
          >
            <!-- Image Thumbnail -->
            <div class={`lg:col-span-5 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
              <div class="relative overflow-visible">
                <div class="overflow-hidden rounded-2xl border-2 border-slate-900 aspect-[4/3] bg-white shadow-sm">
                  <img 
                    src={module.imageSrc} 
                    alt={module.imageAlt} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>

                <div class="absolute -top-4 -right-4 scale-95 bg-white p-2 rounded-2xl border-2 border-slate-900 shadow-sm group-hover:scale-110 group-hover:-rotate-6 transition-all duration-300">
                  <QTMascot client:visible variant={module.mascotVariant} size="sm" />
                </div>
              </div>
            </div>

            <!-- Content Column -->
            <div class={`lg:col-span-7 space-y-6 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
              <div class="space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span 
                    class="px-3.5 py-1 rounded-full text-white font-black text-xs uppercase font-heading shadow-sm border border-slate-900"
                    style={`background-color: ${module.color};`}
                  >
                    {module.badge}
                  </span>
                </div>

                <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 font-heading tracking-tight">
                  {module.title}
                </h2>

                <p class="text-slate-800 text-sm sm:text-base font-semibold leading-relaxed">
                  {module.description}
                </p>
              </div>

              <!-- Action CTA Row -->
              <div class="pt-4 flex items-center justify-between gap-4 border-t border-slate-900/10">
                <a
                  href={`/book-a-quiz?type=${module.typeParam}`}
                  class="px-8 py-3.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-sm uppercase tracking-wider border-2 border-slate-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-0.5 font-heading transition-all inline-flex items-center gap-2 group/btn shrink-0"
                >
                  <span>BOOK NOW!</span>
                  <span class="group-hover/btn:translate-x-1 transition-transform">&rarr;</span>
                </a>
              </div>

            </div>
          </div>
        );
      })}
    </section>

  </main>

  <Footer />
</BaseLayout>
