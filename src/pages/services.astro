---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const SERVICE_MODULES = [
  {
    id: "schools",
    href: "/schools",
    title: "Schools & K-12 Institutions",
    badge: "Schools",
    description: "Timetabled weekly curiosity clubs, thinking skills, and inter-school championships for 250+ partner schools across India.",
    mascotVariant: "reading" as const,
    imageSrc: "https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=800&auto=format&fit=crop",
    imageAlt: "School students learning curiously in classroom",
    ctaText: "Explore School Programs",
    color: "#30B2E7",
    bgTint: "#E8F6FD"
  },
  {
    id: "companies",
    href: "/companies",
    title: "Corporates & Hybrid Teams",
    badge: "Corporate",
    description: "High-impact employee engagement, Friday trivia leagues, and gamified new-hire onboarding for 80+ top companies.",
    mascotVariant: "professional" as const,
    imageSrc: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Corporate team collaborating during live event",
    ctaText: "Explore Corporate Solutions",
    color: "#75B543",
    bgTint: "#EDF7E5"
  },
  {
    id: "colleges",
    href: "/colleges",
    title: "Colleges & Campus Fests",
    badge: "Colleges",
    description: "Multi-disciplinary campus quiz championships, law moot trivia, finance leagues, and STEM hackathons across premier universities.",
    mascotVariant: "idea" as const,
    imageSrc: "https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=800&auto=format&fit=crop",
    imageAlt: "College students celebrating graduation and campus fest",
    ctaText: "Explore College Programs",
    color: "#FDB913",
    bgTint: "#FFF8E1"
  },
  {
    id: "communities",
    href: "/communities",
    title: "Communities & Families",
    badge: "Communities",
    description: "Screen-free family game nights, apartment complex tournaments, and landmark celebrations bringing generations together.",
    mascotVariant: "curious" as const,
    imageSrc: "https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Friends gathering happily at a community event",
    ctaText: "Explore Community Programs",
    color: "#30B2E7",
    bgTint: "#E8F6FD"
  },
  {
    id: "custom",
    href: "/custom",
    title: "Custom Experiences & Quests",
    badge: "Custom",
    description: "Bespoke curiosity experiences, museum treasure hunts, podcast trivia, and custom brand activations designed from scratch.",
    mascotVariant: "trophy" as const,
    imageSrc: "https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=800&auto=format&fit=crop",
    imageAlt: "Team designing custom learning experience",
    ctaText: "Explore Custom Quests",
    color: "#FDB913",
    bgTint: "#FFF8E1"
  }
];

const servicesSchema = {
  "@type": "ItemList",
  "@id": "https://qshala.vercel.app/services#list",
  "name": "QShala Services & Learning Modules",
  "itemListElement": SERVICE_MODULES.map((service, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Service",
      "name": service.title,
      "description": service.description,
      "serviceType": service.badge,
      "provider": {
        "@id": "https://qshala.vercel.app/#organization"
      }
    }
  }))
};
---

<BaseLayout 
  title="Quriosity Services & Programs | QShala India"
  description="Consultative learning and quiz programs for K-12 schools, corporate teams, college fests, communities, and custom experiences."
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Services", item: "/services" }
  ]}
  schema={servicesSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-28 pb-24 bg-[#FFFDF5] w-full">

    <!-- Page Header -->
    <section class="py-8 w-full px-4 sm:px-8 md:px-12">
      <div class="max-w-4xl mx-auto text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-slate-200 shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-[#30B2E7] animate-ping"></span>
          <span class="text-xs font-black uppercase text-slate-800 tracking-wider font-heading">
            Our Learning Programs
          </span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading">
          Curiosity for Every Audience.
        </h1>

        <p class="text-slate-600 font-semibold text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
          Because sales are consultative, our expert quizmasters and instructional designers tailor every program to your goals. Select an audience below to explore detailed offerings and connect directly with our leads.
        </p>
      </div>
    </section>

    <!-- Services Modules Stack - Simplified & Highly Scrollable -->
    <section class="py-4 max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
      {SERVICE_MODULES.map((module, idx) => {
        const isReversed = idx % 2 !== 0;
        return (
          <div 
            id={module.id}
            class="group p-6 sm:p-8 rounded-3xl transition-all duration-300 border border-slate-200/80 hover:border-slate-300 shadow-sm hover:shadow-md grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-white"
          >
            <!-- Image Thumbnail -->
            <div class={`lg:col-span-5 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
              <div class="relative">
                <div class="overflow-hidden rounded-2xl aspect-[16/10] bg-slate-100 shadow-sm">
                  <img 
                    src={module.imageSrc} 
                    alt={module.imageAlt} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>

                <div class="absolute -top-3 -right-3 bg-white p-2 rounded-2xl shadow-sm border border-slate-100 group-hover:scale-110 group-hover:-rotate-6 transition-all duration-300">
                  <QTMascot client:visible variant={module.mascotVariant} size="sm" />
                </div>
              </div>
            </div>

            <!-- Content Column: Label, Title, One Brief Line, CTA Button -->
            <div class={`lg:col-span-7 space-y-4 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
              <div class="space-y-2">
                <span 
                  class="inline-block px-3.5 py-1 rounded-full text-white font-black text-xs uppercase font-heading shadow-sm"
                  style={`background-color: ${module.color};`}
                >
                  {module.badge}
                </span>

                <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 font-heading tracking-tight">
                  {module.title}
                </h2>

                <p class="text-slate-700 text-sm sm:text-base font-semibold leading-relaxed">
                  {module.description}
                </p>
              </div>

              <!-- Action CTA -->
              <div class="pt-2">
                <a
                  href={module.href}
                  class="px-7 py-3 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs sm:text-sm uppercase tracking-wider shadow-sm hover:shadow-md hover:-translate-y-0.5 font-heading transition-all inline-flex items-center gap-2 group/btn"
                >
                  <span>{module.ctaText}</span>
                  <span class="group-hover/btn:translate-x-1 transition-transform">&rarr;</span>
                </a>
              </div>

            </div>
          </div>
        );
      })}
    </section>

  </main>

  <Footer />
</BaseLayout>
