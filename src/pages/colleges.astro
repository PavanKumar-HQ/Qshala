---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const campusServiceSchema = {
  "@type": "Service",
  "@id": "https://qshala.vercel.app/colleges#service",
  "name": "QShala for Colleges & Universities",
  "serviceType": "Campus Quizzes & Collegiate Championships",
  "description": "High-octane multi-disciplinary quiz championships for colleges and universities across India.",
  "provider": {
    "@id": "https://qshala.vercel.app/#organization"
  }
};
---

<BaseLayout 
  title="QShala for Colleges & Campus Fests | Collegiate Quizzing"
  description="High-energy quiz championships, Law moot trivia, Finance leagues, and STEM hackathons across premier colleges and universities."
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Services", item: "/services" },
    { name: "For Colleges", item: "/colleges" }
  ]}
  schema={campusServiceSchema}
>
  <Navbar />
  
  <main id="main-content" class="flex-grow pt-28 pb-24 px-4 sm:px-8 max-w-7xl mx-auto space-y-16 bg-[#FFFDF5]">
    
    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto space-y-4 pt-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-sm">
        Colleges &amp; Universities
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
        Multi-Disciplinary Campus Quizzing.
      </h1>
      <p class="text-slate-600 font-semibold text-base sm:text-lg leading-relaxed">
        Bringing high-octane quiz championships to India's top colleges. Packed auditoriums, sharp socratic questions, and high-energy quizzing across every academic discipline.
      </p>
    </div>

    <!-- Mascot Spotlight -->
    <div class="flex justify-center">
      <QTMascot client:visible variant="idea" size="lg" badgeText="Campus Champions" />
    </div>

    <!-- Discipline Quests Grid -->
    <div class="space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading">
          Domain-Specific Campus Quizzes
        </h2>
        <p class="text-slate-600 text-sm font-semibold">
          Curated by professional domain researchers and quizmasters.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          {
            title: "Law & Constitutional Trivia",
            desc: "Landmark cases, constitutional history, and legal logic for law colleges and moot court festivals.",
            bg: "bg-[#FFF8E1]",
            accent: "#FDB913"
          },
          {
            title: "Finance & Strategy Leagues",
            desc: "Market dynamics, corporate history, business simulations, and fintech trivia for B-Schools and commerce fests.",
            bg: "bg-[#EDF7E5]",
            accent: "#75B543"
          },
          {
            title: "STEM & Tech Hackathon Quizzes",
            desc: "Deep tech, quantum physics, coding lore, space exploration, and AI innovations for engineering colleges.",
            bg: "bg-[#E8F6FD]",
            accent: "#30B2E7"
          },
          {
            title: "Literature, Arts & Culture",
            desc: "Philosophy, art history, linguistics, world cinema, and pop culture for liberal arts festivals.",
            bg: "bg-[#F3E8FF]",
            accent: "#9333EA"
          }
        ].map(item => (
          <div class={`rounded-3xl p-6 border border-slate-200/80 shadow-sm hover:shadow-md transition-all ${item.bg} space-y-3`}>
            <span class="w-3 h-3 rounded-full inline-block" style={`background-color: ${item.accent};`}></span>
            <h3 class="text-xl font-black font-heading text-slate-900 leading-snug">{item.title}</h3>
            <p class="text-slate-700 text-xs font-semibold leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- DIRECT DEPARTMENT CONTACT & CONSULTATIVE SALES -->
    <div class="bg-[#FFF8E1] rounded-3xl p-8 md:p-12 border border-amber-200/80 shadow-sm text-center max-w-4xl mx-auto space-y-8">
      <div class="space-y-3">
        <span class="px-4 py-1.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase font-heading shadow-sm">
          Campus Consultations
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading">
          Connect with Our Campus Quizzing Team
        </h2>
        <p class="text-slate-700 font-semibold text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Planning an annual college fest, inter-departmental quiz, or national collegiate championship? Reach our Campus Lead or call Sachin directly.
        </p>
      </div>

      <!-- Direct Contact Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto text-left">
        
        {/* Campus Lead */}
        <div class="p-6 rounded-2xl bg-white border border-amber-100 shadow-sm space-y-3">
          <div class="text-xs font-black uppercase text-amber-600 font-heading">Campus Quizzing Lead</div>
          <div class="text-lg font-black text-slate-900 font-heading">Higher Ed Partnerships</div>
          <div class="text-xs text-slate-600 font-semibold">College Fests &amp; Departmental Tournaments</div>
          <div class="pt-2 space-y-2">
            <a 
              href="mailto:qshala@walnuts.co.in?subject=Campus%20Fest%20Inquiry" 
              class="inline-flex items-center gap-2 text-xs font-black text-[#30B2E7] hover:underline font-heading"
            >
              ✉ qshala@walnuts.co.in
            </a>
            <div>
              <a 
                href="tel:+918971676100" 
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#30B2E7] text-white font-black text-xs font-heading shadow-sm hover:bg-sky-500 transition-colors"
              >
                📞 Call Campus Team: +91 89716 76100
              </a>
            </div>
          </div>
        </div>

        {/* Sachin Ravi Direct */}
        <div class="p-6 rounded-2xl bg-white border border-amber-100 shadow-sm space-y-3">
          <div class="text-xs font-black uppercase text-amber-600 font-heading">Founder &amp; Quizmaster</div>
          <div class="text-lg font-black text-slate-900 font-heading">Sachin Ravi</div>
          <div class="text-xs text-slate-600 font-semibold">Fest Stage Hosting &amp; National Finals</div>
          <div class="pt-2 space-y-2">
            <a 
              href="mailto:sachin@walnuts.co.in?subject=College%20Quiz%20Inquiry%20for%20Sachin" 
              class="inline-flex items-center gap-2 text-xs font-black text-amber-600 hover:underline font-heading"
            >
              ✉ sachin@walnuts.co.in
            </a>
            <div>
              <a 
                href="tel:+918971676100" 
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs font-heading shadow-sm hover:bg-amber-400 transition-colors"
              >
                📞 Call Sachin: +91 89716 76100
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Quick WhatsApp Action -->
      <div class="pt-2">
        <a 
          href="https://wa.me/918971676100?text=Hi%20QShala,%20we%20want%20to%20host%20a%20quiz%20for%20our%20college%20fest." 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all"
        >
          <span>Chat on WhatsApp &rarr;</span>
        </a>
      </div>
    </div>

  </main>
  
  <Footer />
</BaseLayout>
