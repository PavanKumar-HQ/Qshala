---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ShopStorefront, { type ProductItem } from '../components/ShopStorefront';
import { getProducts } from '../lib/sanity/api';
import { getImageUrl } from '../lib/sanity/image';

const cmsProducts = await getProducts();

const CATEGORY_MAP: Record<string, ProductItem['category']> = {
  Games: 'Games',
  Game: 'Games',
  Books: 'Books',
  Book: 'Books',
  'Learning Kits': 'Learning Kits',
  'Learning Kit': 'Learning Kits',
  Stationery: 'Stationery',
  'QShala Merch': 'QShala Merch'
};

function parsePrice(val: number | string | undefined): number {
  const num = typeof val === 'number' ? val : Number.parseFloat(String(val || '').replace(/[^0-9.]/g, ''));
  return Number.isFinite(num) && num > 0 ? num : 299;
}

const formattedProducts: ProductItem[] = cmsProducts.map((p, idx) => {
  const numPrice = parsePrice(p.price);
  const validCat: ProductItem['category'] = CATEGORY_MAP[p.category] || 'QShala Merch';
  const fallbackImg = (p as any).imageSrc || (p as any).imageUrl || 'https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?q=80&w=800&auto=format&fit=crop';

  return {
    id: p._id || p.id || `prod-${idx + 1}`,
    title: p.title,
    price: numPrice,
    originalPrice: p.originalPrice || Math.round(numPrice * 1.25),
    category: validCat,
    subtitle: p.subtitle || p.description?.slice(0, 50) || '',
    description: p.description || '',
    imageSrc: p.image ? getImageUrl(p.image, 800, 600) : fallbackImg,
    badge: p.badge || (p.isPopular ? 'Popular' : undefined),
    cardColor: p.cardColor || '#FFF8E1',
    mascotVariant: ((p.mascotVariant as any) || 'curious')
  };
});

const shopSchema = {
  "@type": "OfferCatalog",
  "@id": "https://qshala.vercel.app/shop#catalog",
  "name": "QShala Quriosity Store & Thinking Games",
  "description": "Curated socratic books, brain teasers, interactive quiz card games, and official QT mascot merchandise.",
  "itemListElement": formattedProducts.map((product, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Product",
      "name": product.title,
      "description": product.description,
      "category": product.category,
      "brand": {
        "@type": "Brand",
        "name": "QShala"
      },
      "offers": {
        "@type": "Offer",
        "priceCurrency": "INR",
        "price": product.price,
        "availability": "https://schema.org/InStock",
        "seller": {
          "@id": "https://qshala.vercel.app/#organization"
        }
      }
    }
  }))
};
---

<BaseLayout 
  title="Quriosity Store | Books, Thinking Games & Merch | QShala"
  description="Explore the QShala Store: curated socratic books, brain teasers, interactive quiz card games, and official QT mascot merchandise."
  pageType="ItemPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Store", item: "/shop" }
  ]}
  schema={shopSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-header-safe pb-24 bg-[#FFFDF5] w-full">
    <section class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 md:px-12 py-6">
      <ShopStorefront client:load initialProducts={formattedProducts} />
    </section>
  </main>

  <Footer />
</BaseLayout>
