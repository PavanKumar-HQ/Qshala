---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';
import FAQSection from '../components/FAQSection';

const CAREERS_ROLES = [
  {
    title: "Marketing Manager",
    description: "Lead brand campaigns, school outreach, and digital quriosity stories.",
    imageSrc: "https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=800&auto=format&fit=crop",
    color: "#EDF7E5"
  },
  {
    title: "Operations Associate",
    description: "Manage live quiz event logistics, buzzer setups, and school coordination.",
    imageSrc: "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=800&auto=format&fit=crop",
    color: "#FFF8E1"
  },
  {
    title: "Engagement Associate",
    description: "Facilitate socratic sessions, host interactive trivia, and inspire young quizzers.",
    imageSrc: "https://images.unsplash.com/photo-1577896851231-70ef18881754?q=80&w=800&auto=format&fit=crop",
    color: "#E8F6FD"
  },
  {
    title: "Video Editor",
    description: "Craft exciting video highlight reels, QShots clips, and animated stories.",
    imageSrc: "https://images.unsplash.com/photo-1536240478700-b869070f9279?q=80&w=800&auto=format&fit=crop",
    color: "#EDF7E5"
  }
];
---

<BaseLayout title="Contact Us | Careers & Locations | QShala">
  <Navbar />

  <main class="flex-grow pt-28 pb-24 overflow-x-hidden bg-[#FFFDF5] w-full">

    <!-- Top Header -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-6 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase font-heading shadow-sm">
        <span>Get in Touch</span>
        <QTMascot client:visible variant="happy" size="sm" />
      </div>

      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 font-heading tracking-tight">
        We&apos;re All Ears for Your Questions!
      </h1>
      
      <p class="text-slate-600 font-semibold text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Connect with the QShala team for school inquiries, corporate offsites, career applications, or custom trivia events.
      </p>
    </section>

    <!-- SECTION 1: Address & Reach Out Banners (Matching Brief Layout) -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-6 space-y-12">
      
      <!-- Write to us the old school way (Physical Address) -->
      <div class="p-8 sm:p-10 rounded-3xl bg-white border-2 border-slate-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] space-y-4 max-w-4xl mx-auto">
        <div class="flex items-center gap-3">
          <span class="w-10 h-10 rounded-2xl bg-[#30B2E7] text-white flex items-center justify-center font-bold text-lg border border-slate-900 shadow-sm">
            🏢
          </span>
          <h2 class="text-2xl font-black text-slate-900 font-heading">
            Write to us the old school way
          </h2>
        </div>

        <p class="text-slate-700 text-sm sm:text-base font-semibold leading-relaxed pl-13">
          1st Floor, 680, Fortuna 1, 8th Main Road, 14th Cross Road, Near Delmia Circle, 3rd Phase, J.P. Nagar, Bengaluru, Karnataka - 560078
        </p>

        <div class="pl-13 pt-2">
          <a
            href="https://maps.google.com/?q=Walnut+Knowledge+Solutions+JP+Nagar+Bengaluru"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-2.5 rounded-full bg-[#30B2E7] hover:bg-sky-400 text-white font-black text-xs uppercase font-heading border-2 border-slate-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-0.5 transition-all inline-flex items-center gap-2"
          >
            <span>VIEW ON MAP</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Reach out! Action Banner Buttons (Matching Brief Pill Cards) -->
      <div class="space-y-4 max-w-4xl mx-auto">
        <h2 class="text-2xl font-black text-slate-900 font-heading text-center">
          Reach out!
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- CALL US AT -->
          <a
            href="tel:+918971676100"
            class="p-6 rounded-3xl bg-[#FFF8E1] hover:bg-amber-100 border-2 border-slate-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-1 transition-all flex items-center justify-center gap-4 text-center group"
          >
            <span class="w-10 h-10 rounded-2xl bg-[#FDB913] text-slate-950 flex items-center justify-center text-xl font-bold border border-slate-900 shadow-sm shrink-0">
              📞
            </span>
            <div class="text-slate-900 font-heading font-black text-lg sm:text-xl group-hover:text-amber-700 transition-colors">
              CALL US AT +91 89716 76100
            </div>
          </a>

          <!-- WRITE TO US AT -->
          <a
            href="mailto:qshala@walnuts.co.in"
            class="p-6 rounded-3xl bg-[#E8F6FD] hover:bg-sky-100 border-2 border-slate-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-1 transition-all flex items-center justify-center gap-4 text-center group"
          >
            <span class="w-10 h-10 rounded-2xl bg-[#30B2E7] text-white flex items-center justify-center text-xl font-bold border border-slate-900 shadow-sm shrink-0">
              ✉
            </span>
            <div class="text-slate-900 font-heading font-black text-base sm:text-lg group-hover:text-sky-700 transition-colors truncate">
              WRITE TO US AT qshala@walnuts.co.in
            </div>
          </a>

        </div>
      </div>

    </section>

    <!-- SECTION 2: CAREERS (Matching Brief Grid & Cards) -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-10 bg-[#EDF7E5] border-y-2 border-slate-900/10 my-8">
      <div class="max-w-6xl mx-auto space-y-8">
        
        <div class="text-center space-y-2">
          <span class="px-4 py-1 rounded-full bg-[#75B543] text-white font-black text-xs uppercase font-heading">
            CAREERS
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading tracking-tight">
            Love to learn, teach and champion Quriosity? Work with us!
          </h2>
          <p class="text-slate-700 text-xs sm:text-sm font-semibold">
            Send your portfolio or resume to <a href="mailto:work@walnuts.co.in" class="text-slate-900 font-black underline hover:text-[#75B543]">work@walnuts.co.in</a>
          </p>
        </div>

        <!-- 4 Role Cards Grid (Matching Brief) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {CAREERS_ROLES.map((role) => (
            <a
              href="mailto:work@walnuts.co.in?subject=Application for " + role.title
              class="rounded-3xl p-5 border-2 border-slate-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between space-y-4 group"
              style={`background-color: ${role.color};`}
            >
              <div class="space-y-3">
                <div class="relative overflow-hidden rounded-2xl aspect-[4/3] border-2 border-slate-900 bg-white">
                  <img
                    src={role.imageSrc}
                    alt={role.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>

                <h3 class="text-lg font-black text-slate-900 font-heading leading-snug">
                  {role.title}
                </h3>

                <p class="text-slate-700 text-xs font-semibold leading-relaxed">
                  {role.description}
                </p>
              </div>

              <div class="pt-3 border-t border-slate-900/10 flex items-center justify-between font-heading font-black text-xs text-slate-900 group-hover:text-[#75B543] transition-colors">
                <span>Apply via Email</span>
                <span>&rarr;</span>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

    <!-- SECTION 3: FREQUENTLY ASKED QUESTIONS -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-8">
      <div class="max-w-4xl mx-auto space-y-8">
        <div class="text-center space-y-2">
          <span class="px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm border border-[#75B543]">
            Need Clarification?
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading tracking-tight">
            Frequently Asked Questions
          </h2>
        </div>
        <FAQSection client:visible />
      </div>
    </section>

    <!-- SECTION 4: Quick Inquiry Message Form -->
    <section class="w-full px-4 sm:px-8 md:px-12 py-10">
      <div class="max-w-2xl mx-auto bg-white rounded-3xl p-8 border-2 border-slate-900 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] space-y-6">
        <div class="text-center space-y-1">
          <h3 class="text-2xl font-black text-slate-900 font-heading">Send Us a Direct Message</h3>
          <p class="text-slate-600 text-xs font-semibold">We respond to all inquiries within 24 hours.</p>
        </div>

        <form action="mailto:qshala@walnuts.co.in" method="post" enctype="text/plain" class="space-y-4">
          <div>
            <label class="block text-xs font-black uppercase text-slate-900 mb-1 font-heading">Your Name</label>
            <input type="text" name="name" required class="w-full px-4 py-3 rounded-2xl border-2 border-slate-900 bg-[#FFFDF5] text-slate-900 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-[#30B2E7]" placeholder="e.g. Ananya Sharma" />
          </div>

          <div>
            <label class="block text-xs font-black uppercase text-slate-900 mb-1 font-heading">Email Address</label>
            <input type="email" name="email" required class="w-full px-4 py-3 rounded-2xl border-2 border-slate-900 bg-[#FFFDF5] text-slate-900 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-[#30B2E7]" placeholder="ananya@example.com" />
          </div>

          <div>
            <label class="block text-xs font-black uppercase text-slate-900 mb-1 font-heading">Message</label>
            <textarea name="message" rows="4" required class="w-full px-4 py-3 rounded-2xl border-2 border-slate-900 bg-[#FFFDF5] text-slate-900 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-[#30B2E7]" placeholder="How can we help your school, company, or event?"></textarea>
          </div>

          <button type="submit" class="w-full py-3.5 bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black rounded-2xl border-2 border-slate-900 font-heading shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] uppercase tracking-wider text-xs transition-all">
            Send Message &rarr;
          </button>
        </form>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
