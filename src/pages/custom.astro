---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const customServiceSchema = {
  "@type": "Service",
  "@id": "https://qshala.vercel.app/custom#service",
  "name": "QShala Custom Experiences",
  "serviceType": "Bespoke Learning Quests & Custom Trivia Design",
  "description": "Custom learning experiences, museum hunts, brand activations, and interactive game concept development.",
  "provider": {
    "@id": "https://qshala.vercel.app/#organization"
  }
};
---

<BaseLayout 
  title="Custom Experiences & Quests | QShala India"
  description="Bespoke curiosity experiences, museum treasure hunts, podcast trivia, and custom brand activations designed by QShala."
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Services", item: "/services" },
    { name: "Custom Experiences", item: "/custom" }
  ]}
  schema={customServiceSchema}
>
  <Navbar />
  
  <main id="main-content" class="flex-grow pt-28 pb-24 px-4 sm:px-8 max-w-7xl mx-auto space-y-16 bg-[#FFFDF5]">
    
    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto space-y-4 pt-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-sm">
        Bespoke Quests
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
        You Imagine It, We Bring the Curiosity.
      </h1>
      <p class="text-slate-600 font-semibold text-base sm:text-lg leading-relaxed">
        From museum scavenger hunts and corporate brand challenge games to interactive podcast trivia and custom educational apps—we craft bespoke experiences around any topic.
      </p>
    </div>

    <!-- Mascot Spotlight -->
    <div class="flex justify-center">
      <QTMascot client:visible variant="trophy" size="lg" badgeText="Endless Possibilities!" />
    </div>

    <!-- Formats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        {
          title: "Museum & Heritage Quests",
          desc: "Interactive scavenger hunts turning history museums, art galleries, and botanical gardens into immersive detective trails.",
          bg: "bg-[#FFF8E1]",
          accent: "#FDB913"
        },
        {
          title: "Brand Activations & Challenges",
          desc: "Gamified campaigns that turn your brand lore, product features, or founder story into viral, high-dwell-time interactive quests.",
          bg: "bg-[#E8F6FD]",
          accent: "#30B2E7"
        },
        {
          title: "Podcast & Digital Media Quizzes",
          desc: "Interactive listener trivia and companion quizzes designed for audio podcasts, OTT platforms, and YouTube channels.",
          bg: "bg-[#EDF7E5]",
          accent: "#75B543"
        }
      ].map(item => (
        <div class={`rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-md transition-all ${item.bg} space-y-3`}>
          <span class="w-3 h-3 rounded-full inline-block" style={`background-color: ${item.accent};`}></span>
          <h3 class="text-2xl font-black font-heading text-slate-900 leading-snug">{item.title}</h3>
          <p class="text-slate-700 text-sm font-semibold leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>

    <!-- DIRECT DEPARTMENT CONTACT -->
    <div class="bg-[#FFF8E1] rounded-3xl p-8 md:p-12 border border-amber-200/80 shadow-sm text-center max-w-4xl mx-auto space-y-8">
      <div class="space-y-3">
        <span class="px-4 py-1.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase font-heading shadow-sm">
          Custom Concept Consultations
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading">
          Discuss Your Custom Concept with Us
        </h2>
        <p class="text-slate-700 font-semibold text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Have an unconventional idea or ambitious project? Brainstorm directly with our experience design team or Sachin.
        </p>
      </div>

      <!-- Direct Contact Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto text-left">
        <div class="p-6 rounded-2xl bg-white border border-amber-100 shadow-sm space-y-3">
          <div class="text-xs font-black uppercase text-amber-600 font-heading">Experience Designer</div>
          <div class="text-lg font-black text-slate-900 font-heading">Special Experiences Team</div>
          <div class="text-xs text-slate-600 font-semibold">Custom Quests, Museum Trails &amp; Brand Trivia</div>
          <div class="pt-2 space-y-2">
            <a href="mailto:qshala@walnuts.co.in" class="text-xs font-black text-amber-600 hover:underline block font-heading">
              ✉ qshala@walnuts.co.in
            </a>
            <a href="tel:+918971676100" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#30B2E7] text-white font-black text-xs font-heading shadow-sm hover:bg-sky-500 transition-colors">
              📞 Call Team: +91 89716 76100
            </a>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-amber-100 shadow-sm space-y-3">
          <div class="text-xs font-black uppercase text-amber-600 font-heading">Founder &amp; Experience Architect</div>
          <div class="text-lg font-black text-slate-900 font-heading">Sachin Ravi</div>
          <div class="text-xs text-slate-600 font-semibold">Creative Direction &amp; Bespoke Formats</div>
          <div class="pt-2 space-y-2">
            <a href="mailto:sachin@walnuts.co.in" class="text-xs font-black text-amber-700 hover:underline block font-heading">
              ✉ sachin@walnuts.co.in
            </a>
            <a href="tel:+918971676100" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs font-heading shadow-sm hover:bg-amber-400 transition-colors">
              📞 Call Sachin: +91 89716 76100
            </a>
          </div>
        </div>
      </div>

      <div class="pt-2">
        <a 
          href="https://wa.me/918971676100?text=Hi%20QShala,%20we%20have%20a%20custom%20experience%20idea%20we%20would%20like%20to%20develop." 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all"
        >
          <span>Chat on WhatsApp &rarr;</span>
        </a>
      </div>
    </div>

  </main>
  
  <Footer />
</BaseLayout>
