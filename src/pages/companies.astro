---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const corporateServiceSchema = {
  "@type": "Service",
  "@id": "https://qshala.vercel.app/companies#service",
  "name": "QShala for Corporates & Teams",
  "serviceType": "Corporate L&D and Employee Engagement",
  "description": "High-octane corporate trivia championships, gamified new-hire onboarding, and leadership team bonding offsites.",
  "provider": {
    "@id": "https://qshala.vercel.app/#organization"
  }
};
---

<BaseLayout 
  title="QShala for Corporates | Employee Engagement & Live Trivia"
  description="High-impact corporate trivia nights, gamified onboarding, and leadership offsites for 80+ top companies including Google, Flipkart, Infosys, and Amazon."
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Services", item: "/services" },
    { name: "For Corporates", item: "/companies" }
  ]}
  schema={corporateServiceSchema}
>
  <Navbar />
  
  <main id="main-content" class="flex-grow pt-28 pb-24 px-4 sm:px-8 max-w-7xl mx-auto space-y-16 bg-[#FFFDF5]">
    
    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto space-y-4 pt-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
        Corporate L&D &amp; HR
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
        Corporate Trivia &amp; Team Engagement.
      </h1>
      <p class="text-slate-600 font-semibold text-base sm:text-lg leading-relaxed">
        Connecting hybrid teams across offices with customized live trivia championships, onboarding quests, and high-energy leadership offsites.
      </p>
    </div>

    <!-- Mascot Spotlight -->
    <div class="flex justify-center">
      <QTMascot client:visible variant="professional" size="lg" badgeText="80+ Corporate Partners" />
    </div>

    <!-- Popular Formats Grid -->
    <div class="space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading">
          Popular Corporate Formats
        </h2>
        <p class="text-slate-600 text-sm font-semibold">
          Tailored for remote, hybrid, or in-person company offsites and townhalls.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            title: "High-Octane Trivia Nights",
            desc: "Fast-paced, team-based trivia designed for Friday evening unwinds, cross-functional mixers, or annual corporate celebrations.",
            bg: "bg-[#FFF8E1]",
            accent: "#FDB913"
          },
          {
            title: "Gamified Onboarding Quests",
            desc: "Turn boring slide decks into interactive quest cards. Help new hires absorb company history, culture, and compliance rules playfully.",
            bg: "bg-[#E8F6FD]",
            accent: "#30B2E7"
          },
          {
            title: "Custom Brand Championships",
            desc: "Product launches, customer engagement programs, or employee training gamified using our proprietary digital buzzers.",
            bg: "bg-[#EDF7E5]",
            accent: "#75B543"
          }
        ].map(item => (
          <div class={`rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-md transition-all ${item.bg} space-y-3`}>
            <span class="w-3 h-3 rounded-full inline-block" style={`background-color: ${item.accent};`}></span>
            <h3 class="text-2xl font-black font-heading text-slate-900">{item.title}</h3>
            <p class="text-slate-700 text-sm font-semibold leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Stats Strip -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {[
        { value: "80+", label: "Corporate Clients" },
        { value: "50,000+", label: "Employees Engaged" },
        { value: "92/100", label: "Average NPS Score" }
      ].map(stat => (
        <div class="flex flex-col items-center justify-center py-8 px-6 rounded-3xl border border-slate-200/80 bg-white shadow-sm text-center">
          <span class="text-4xl font-black text-[#75B543] font-heading">{stat.value}</span>
          <span class="text-xs font-black uppercase tracking-wider text-slate-600 mt-2 font-heading">{stat.label}</span>
        </div>
      ))}
    </div>

    <!-- DIRECT DEPARTMENT CONTACT & CONSULTATIVE SALES (No Form) -->
    <div class="bg-[#EDF7E5] rounded-3xl p-8 md:p-12 border border-emerald-200/80 shadow-sm text-center max-w-4xl mx-auto space-y-8">
      <div class="space-y-3">
        <span class="px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase font-heading shadow-sm">
          Consultative Engagement
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading">
          Speak with Our Corporate Engagement Lead
        </h2>
        <p class="text-slate-700 font-semibold text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Whether planning an offsite for 30 leaders or an interactive townhall for 3,000 employees, connect with our corporate team directly or reach Sachin.
        </p>
      </div>

      <!-- Direct Contact Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto text-left">
        
        {/* Corporate Engagement Lead */}
        <div class="p-6 rounded-2xl bg-white border border-emerald-100 shadow-sm space-y-3">
          <div class="text-xs font-black uppercase text-emerald-600 font-heading">Corporate L&amp;D Lead</div>
          <div class="text-lg font-black text-slate-900 font-heading">Corporate Solutions Team</div>
          <div class="text-xs text-slate-600 font-semibold">Townhalls, Offsites &amp; Gamified Onboarding</div>
          <div class="pt-2 space-y-2">
            <a 
              href="mailto:qshala@walnuts.co.in?subject=Corporate%20Engagement%20Inquiry" 
              class="inline-flex items-center gap-2 text-xs font-black text-[#75B543] hover:underline font-heading"
            >
              ✉ qshala@walnuts.co.in
            </a>
            <div>
              <a 
                href="tel:+918971676100" 
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#75B543] text-white font-black text-xs font-heading shadow-sm hover:bg-emerald-600 transition-colors"
              >
                📞 Call Corporate Team: +91 89716 76100
              </a>
            </div>
          </div>
        </div>

        {/* Sachin Ravi Direct */}
        <div class="p-6 rounded-2xl bg-white border border-emerald-100 shadow-sm space-y-3">
          <div class="text-xs font-black uppercase text-emerald-600 font-heading">Founder &amp; Host</div>
          <div class="text-lg font-black text-slate-900 font-heading">Sachin Ravi</div>
          <div class="text-xs text-slate-600 font-semibold">Leadership Offsites &amp; Custom Keynotes</div>
          <div class="pt-2 space-y-2">
            <a 
              href="mailto:sachin@walnuts.co.in?subject=Corporate%20Inquiry%20for%20Sachin" 
              class="inline-flex items-center gap-2 text-xs font-black text-emerald-700 hover:underline font-heading"
            >
              ✉ sachin@walnuts.co.in
            </a>
            <div>
              <a 
                href="tel:+918971676100" 
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs font-heading shadow-sm hover:bg-amber-400 transition-colors"
              >
                📞 Call Sachin: +91 89716 76100
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Quick WhatsApp Action -->
      <div class="pt-2">
        <a 
          href="https://wa.me/918971676100?text=Hi%20QShala,%20we%20would%20like%20to%20plan%20a%20corporate%20trivia%20or%20team%20engagement%20session." 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all"
        >
          <span>Chat on WhatsApp &rarr;</span>
        </a>
      </div>
    </div>

  </main>
  
  <Footer />
</BaseLayout>
