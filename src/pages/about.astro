---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';
import OurTeamShowcase from '../components/OurTeamShowcase';

const INVESTORS_ADVISORS = [
  {
    name: "Rainmatter Foundation",
    category: "Impact & Climate Education Partner",
    description: "Supporting QShala's mission to bring socratic learning & environmental curiosity to 100,000+ school students.",
    color: "#75B543",
    bg: "#EDF7E5",
    badge: "Impact Partner"
  },
  {
    name: "Axilor Ventures",
    category: "Early Stage Accelerator",
    description: "Backing QShala's scalable EdTech methodology and school community engagement platforms.",
    color: "#30B2E7",
    bg: "#E8F6FD",
    badge: "Accelerator"
  },
  {
    name: "Mindhouse & Industry Angels",
    category: "Angel Investors & EdTech Leaders",
    description: "Guided by founders and executives from India's leading consumer tech, media, and education ecosystems.",
    color: "#FDB913",
    bg: "#FFF8E1",
    badge: "Angel Backing"
  },
  {
    name: "K-12 Advisory Council",
    category: "Academic & Pedagogical Council",
    description: "Composed of former principals and curriculum directors from top ICSE, CBSE, and IB schools across India.",
    color: "#A855F7",
    bg: "#F3E8FF",
    badge: "Academic Board"
  }
];
---

<BaseLayout title="About Us | QShala - India's Curiosity Company">
  <Navbar />

  <main class="flex-grow pt-28 pb-20 overflow-x-hidden bg-[#FFFDF5]">

    <!-- 1. HERO: OPEN EDITORIAL MISSION (No Bounding Boxes) -->
    <section class="py-12 md:py-20 relative">
      <!-- Ambient Glowing Orbs -->
      <div class="absolute top-10 left-1/4 w-96 h-96 bg-[#30B2E7]/15 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
      <div class="absolute top-40 right-1/4 w-96 h-96 bg-[#FDB913]/20 rounded-full blur-3xl pointer-events-none animate-pulse"></div>

      <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="text-center max-w-4xl mx-auto space-y-6">
          <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white border border-slate-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FDB913] animate-ping"></span>
            <span class="text-xs font-black uppercase tracking-wider font-heading text-slate-800">
              Our Story &amp; Brand Philosophy
            </span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
            We Believe <span class="text-[#30B2E7]">Curiosity</span> is the Greatest Superpower.
          </h1>

          <p class="text-slate-700 text-lg sm:text-xl font-semibold max-w-3xl mx-auto leading-relaxed">
            In a world obsessed with standard answers and test marks, QShala was born with one simple goal: <span class="text-[#75B543] font-black underline decoration-[#75B543]/40 decoration-4">&ldquo;Growth via Curiosity.&rdquo;</span>
          </p>

          <!-- 3 Open Editorial Pillars -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-12 text-left">
            <div class="space-y-3">
              <div class="inline-block px-3 py-1 rounded-full bg-[#30B2E7]/15 text-[#30B2E7] font-black text-xs uppercase font-heading">
                01 &bull; Qurious Sky
              </div>
              <h3 class="text-2xl font-black text-slate-900 font-heading">Boundless Wonder</h3>
              <p class="text-sm text-slate-600 font-medium leading-relaxed">
                Inspiring socratic exploration and natural inquiry for school-going children and young minds.
              </p>
            </div>

            <div class="space-y-3">
              <div class="inline-block px-3 py-1 rounded-full bg-[#FDB913]/20 text-amber-600 font-black text-xs uppercase font-heading">
                02 &bull; Joy of Quest
              </div>
              <h3 class="text-2xl font-black text-slate-900 font-heading">Adventurous Quest</h3>
              <p class="text-sm text-slate-600 font-medium leading-relaxed">
                Transforming learning into an exciting story full of discovery, live quizzes, and fun.
              </p>
            </div>

            <div class="space-y-3">
              <div class="inline-block px-3 py-1 rounded-full bg-[#75B543]/20 text-[#75B543] font-black text-xs uppercase font-heading">
                03 &bull; Always Questioning
              </div>
              <h3 class="text-2xl font-black text-slate-900 font-heading">Active Citizenship</h3>
              <p class="text-sm text-slate-600 font-medium leading-relaxed">
                Nurturing an empathetic, engaged citizenry equipped with 21st-century critical thinking.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. FOUNDER STORY: OPEN EDITORIAL STORYLINE -->
    <section id="founder-story" class="py-16 md:py-20 bg-[#FFF8E1] relative">
      <div class="max-w-6xl mx-auto px-6 space-y-12">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div class="space-y-2">
            <span class="px-3.5 py-1.5 rounded-full bg-white text-slate-800 font-black text-xs uppercase tracking-wider font-heading shadow-sm border border-slate-200">
              The Journey &bull; Est. 2014
            </span>
            <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
              From Quizmasters to Curiosity Pioneers.
            </h2>
          </div>
          <div class="text-xs font-black text-amber-700 uppercase tracking-widest font-heading">
            Bengaluru &bull; 10+ Years of Impact
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-7 space-y-6">
            <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-heading leading-snug">
              &ldquo;Why does learning stop being fun when kids enter the classroom?&rdquo;
            </h3>
            
            <p class="text-slate-700 text-base leading-relaxed font-semibold">
              In 2014, two national-level quizmasters and TEDx speakers—<strong>Sachin Ravi</strong> and <strong>Raghavan A.</strong>—noticed a striking pattern. While young children naturally ask hundreds of questions a day, traditional schooling slowly turns off that spark.
            </p>
            
            <p class="text-slate-700 text-base leading-relaxed font-semibold">
              They started QShala to prove that learning shouldn&apos;t be about memorizing static facts for marks. Instead, it should be an active, socratic sport—full of stories, curiosity clubs, real-world current affairs, and friendly team quests.
            </p>
            
            <p class="text-slate-700 text-base leading-relaxed font-semibold">
              Over the past decade, QShala has grown into an ecosystem partnering with <strong>250+ premier K-12 schools</strong> and <strong>80+ global corporates</strong>, impacting over 150,000+ learners across 18+ cities.
            </p>

            <div class="pt-4 flex items-center gap-6">
              <div class="space-y-1">
                <div class="text-3xl font-black text-slate-900 font-heading">150,000+</div>
                <div class="text-xs font-bold text-slate-600">Active Learners</div>
              </div>
              <div class="w-px h-10 bg-slate-300"></div>
              <div class="space-y-1">
                <div class="text-3xl font-black text-slate-900 font-heading">250+</div>
                <div class="text-xs font-bold text-slate-600">School Partners</div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 space-y-6">
            <div class="flex items-center gap-5 p-4 rounded-2xl bg-white/70 border border-slate-200 shadow-sm">
              <QTMascot client:visible variant="sherlock" size="md" />
              <div>
                <span class="px-2 py-0.5 rounded-full bg-[#30B2E7]/20 text-[#30B2E7] font-black text-[10px] uppercase font-heading">Co-Founder</span>
                <h4 class="text-lg font-black text-slate-900 mt-1 font-heading">Sachin Ravi</h4>
                <p class="text-xs text-slate-600 font-medium">Storyteller &amp; Quizmaster</p>
              </div>
            </div>

            <div class="flex items-center gap-5 p-4 rounded-2xl bg-white/70 border border-slate-200 shadow-sm">
              <QTMascot client:visible variant="quizzing" size="md" />
              <div>
                <span class="px-2 py-0.5 rounded-full bg-[#75B543]/20 text-[#75B543] font-black text-[10px] uppercase font-heading">Co-Founder</span>
                <h4 class="text-lg font-black text-slate-900 mt-1 font-heading">Raghavan A.</h4>
                <p class="text-xs text-slate-600 font-medium">Executive &amp; Education Strategist</p>
              </div>
            </div>

            <blockquote class="p-5 rounded-2xl bg-white border border-amber-200 shadow-sm text-xs font-semibold text-slate-800 italic leading-relaxed">
              &ldquo;Our vision is simple: to nurture an empathetic, highly curious generation that never stops asking 'Why?'&rdquo;
            </blockquote>
          </div>

        </div>

      </div>
    </section>

    <!-- 3. MEET QT MASCOT SECTION (MATCHING BRAND GUIDELINES) -->
    <section id="meet-qt" class="py-16 md:py-20 bg-[#FFFDF5] relative">
      <div class="max-w-6xl mx-auto px-6">
        
        <div class="bg-[#FFF5D6] rounded-3xl p-8 md:p-12 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          
          <div class="lg:col-span-7 space-y-6">
            <div class="space-y-2">
              <span class="px-3.5 py-1 rounded-full bg-[#FDB913] text-black font-black text-xs uppercase font-heading">
                MEET QT!
              </span>
              <h2 class="text-3xl md:text-4xl font-black text-slate-900 font-heading leading-tight">
                Meet QT, our mischievously curious black cat!
              </h2>
            </div>

            <p class="text-slate-800 text-base md:text-lg font-semibold leading-relaxed">
              Inspired by the idea of the ever-curious cat, QT embodies the joy of exploring, questioning, and discovering. Unlike old superstitions, QT&apos;s all about luck, fun and sparking curiosity wherever she goes.
            </p>

            <div class="pt-2 flex items-center gap-4">
              <QTMascot client:visible variant="curious" size="md" />
              <div class="text-xs font-bold text-slate-700">
                Official QShala Mascot &bull; Ever-Curious Being
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 space-y-4">
            <div class="text-left space-y-1">
              <h3 class="text-2xl font-black text-slate-900 font-heading">
                QT for your everyday!
              </h3>
              <p class="text-xs font-bold text-slate-600">Download official stickers &amp; emojis:</p>
            </div>

            <div class="flex flex-col gap-2.5">
              <a 
                href="/assets/qt-sticker-pack.zip" 
                download
                class="px-5 py-3 rounded-xl bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm font-heading transition-all flex items-center justify-between group shadow-sm"
              >
                <span>QT Sticker pack</span>
                <span class="text-base group-hover:translate-y-0.5 transition-transform">&darr;</span>
              </a>

              <a 
                href="/assets/qt-emojis.zip" 
                download
                class="px-5 py-3 rounded-xl bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm font-heading transition-all flex items-center justify-between group shadow-sm"
              >
                <span>QT Emojis</span>
                <span class="text-base group-hover:translate-y-0.5 transition-transform">&darr;</span>
              </a>

              <a 
                href="/assets/qt-gifs.zip" 
                download
                class="px-5 py-3 rounded-xl bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm font-heading transition-all flex items-center justify-between group shadow-sm"
              >
                <span>QT Gifs</span>
                <span class="text-base group-hover:translate-y-0.5 transition-transform">&darr;</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 4. SUPPORT (INVESTORS & PARTNERS): OPEN GRID -->
    <section id="investors" class="py-16 md:py-20 bg-[#E8F6FD] relative">
      <div class="max-w-6xl mx-auto px-6 space-y-12">
        
        <div class="text-center max-w-3xl mx-auto space-y-3">
          <span class="px-3.5 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase font-heading">
            Supported By
          </span>
          <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
            Backed &amp; Supported by Industry Pioneers.
          </h2>
          <p class="text-slate-700 text-base font-semibold max-w-xl mx-auto">
            Prominent accelerators, impact foundations, and education leaders supporting QShala&apos;s vision.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {INVESTORS_ADVISORS.map((inv) => (
            <div 
              class="p-6 rounded-2xl bg-white/80 backdrop-blur-sm border border-slate-200/80 shadow-sm flex flex-col justify-between transition-all hover:bg-white hover:shadow-md"
            >
              <div class="space-y-3">
                <span 
                  class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase text-white font-heading inline-block"
                  style={`background-color: ${inv.color};`}
                >
                  {inv.badge}
                </span>
                <h3 class="text-xl font-black text-slate-900 font-heading leading-tight">{inv.name}</h3>
                <div class="text-[11px] font-bold text-slate-600 uppercase tracking-wider">{inv.category}</div>
                <p class="text-slate-700 text-xs font-semibold leading-relaxed pt-1">
                  {inv.description}
                </p>
              </div>

              <div class="mt-6 pt-3 border-t border-slate-200 flex items-center justify-between text-[11px] font-black text-slate-800 font-heading">
                <span>Partner</span>
                <span style={`color: ${inv.color}`}>&check;</span>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 5. OUR TEAM: INTERACTIVE BRAND COLOR SHOWCASE -->
    <section id="our-team" class="py-16 md:py-20 bg-[#FFFDF5] relative">
      <div class="max-w-6xl mx-auto px-6 space-y-12">
        
        <div class="text-center max-w-3xl mx-auto space-y-3">
          <span class="px-3.5 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase font-heading">
            Our Team
          </span>
          <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
            Meet the Curiosity Crew.
          </h2>
          <p class="text-slate-700 text-base font-semibold max-w-xl mx-auto">
            The storytellers, educators, quizmasters, and engineers bringing curiosity to life every single day.
          </p>
        </div>

        <OurTeamShowcase client:visible />

      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
