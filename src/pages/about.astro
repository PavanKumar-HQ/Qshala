---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTAnimatedPlayer from '../components/QTAnimatedPlayer';
import InteractiveTeamShowcase from '../components/InteractiveTeamShowcase';

const INVESTORS_ADVISORS = [
  {
    name: "Nithin Kamath",
    role: "Co-Founder & CEO, Zerodha",
    company: "Zerodha",
    color: "#387ED1",
    badge: "Angel Backer",
    logo: "/assets/logos/zerodha.svg"
  },
  {
    name: "Kalyan Banerjee",
    role: "Co-Founder, Mindtree",
    company: "Mindtree",
    color: "#FDB913",
    badge: "Advisor & Angel",
    logo: "/assets/logos/mindtree.svg"
  },
  {
    name: "Preeti Sawhney",
    role: "Former Director, Lowe Lintas",
    company: "Lowe Lintas",
    color: "#75B543",
    badge: "Strategic Advisor",
    logo: "/assets/logos/lowelintas.png"
  },
  {
    name: "Sanjay Tambwekar",
    role: "CTO, Qwikcilver",
    company: "Qwikcilver",
    color: "#9333EA",
    badge: "Angel Backer",
    logo: "/assets/logos/qwikcilver.svg"
  },
  {
    name: "Suresh Kumar Pinglay",
    role: "Former VP, Oracle India",
    company: "Oracle India",
    color: "#F80000",
    badge: "Strategic Advisor",
    logo: "/assets/logos/oracle.svg"
  },
  {
    name: "Chetan Vinchhi",
    role: "India Head, Uptycs",
    company: "Uptycs",
    color: "#30B2E7",
    badge: "Angel Backer",
    logo: "/assets/logos/uptycs.png"
  }
];
---

<BaseLayout 
  title="About Us — Our Story & Mission | QShala India"
  description="Learn about QShala's mission to replace rote learning with curiosity and wonder. Founded in 2014 by Sachin Ravi & Raghav Chakravarthy, backed by top leaders."
  pageType="AboutPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "About Us", item: "/about" }
  ]}
>
  <Navbar />

  <main id="main-content" class="flex-grow pt-20 md:pt-24 pb-16 overflow-x-hidden bg-[#FFFDF5]">

    <!-- 1. HERO: OPEN EDITORIAL MISSION -->
    <section class="pt-4 pb-8 md:pt-6 md:pb-10 relative overflow-hidden w-full px-4 sm:px-8 md:px-12">
      <!-- Ambient Glowing Orbs -->
      <div class="absolute top-4 left-1/4 w-72 h-72 bg-[#30B2E7]/15 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
      <div class="absolute top-20 right-1/4 w-72 h-72 bg-[#FDB913]/20 rounded-full blur-3xl pointer-events-none animate-pulse"></div>

      <div class="w-full relative z-10">
        <div class="text-center max-w-4xl mx-auto space-y-4">
          <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white border border-slate-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FDB913] animate-ping"></span>
            <span class="text-xs font-black uppercase tracking-wider font-heading text-slate-800">
              Our Story
            </span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
            We Believe <span class="text-[#30B2E7]">Curiosity</span> is the Greatest Superpower.
          </h1>
        </div>
      </div>
    </section>

    <!-- 2. FOUNDER STORY: 2-COLUMN FOUNDER CARDS -->
    <section id="founder-story" class="py-10 md:py-14 bg-[#FFF8E1] relative w-full px-4 sm:px-8 md:px-12">
      <div class="w-full space-y-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div>
            <span class="px-3.5 py-1.5 rounded-full bg-white text-slate-800 font-black text-xs uppercase tracking-wider font-heading shadow-sm border border-slate-200">
              Est. 2014
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full">
          <!-- Sachin Ravi -->
          <div class="p-6 md:p-8 rounded-3xl bg-white/90 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow flex flex-col sm:flex-row items-start gap-6">
            <img 
              src="https://ui-avatars.com/api/?name=Sachin+Ravi&background=FDB913&color=fff&size=200" 
              alt="Sachin Ravi" 
              class="w-20 h-20 md:w-24 md:h-24 rounded-2xl object-cover shadow-sm border-2 border-white shrink-0" 
            />
            <div class="space-y-1.5 flex-1">
              <h3 class="text-2xl font-black text-slate-900 font-heading">Sachin Ravi</h3>
              <p class="text-xs font-black uppercase tracking-wider text-amber-600 font-heading">Co-Founder</p>
              <p class="text-slate-700 text-sm font-semibold leading-relaxed pt-1">
                National-level quizmaster and TEDx speaker on a mission to replace rote memorization with socratic wonder. Passionate about empowering young minds to ask questions and explore through stories and quests.
              </p>
            </div>
          </div>

          <!-- Raghav Chakravarthy -->
          <div class="p-6 md:p-8 rounded-3xl bg-white/90 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow flex flex-col sm:flex-row items-start gap-6">
            <img 
              src="https://ui-avatars.com/api/?name=Raghav+Chakravarthy&background=30B2E7&color=fff&size=200" 
              alt="Raghav Chakravarthy" 
              class="w-20 h-20 md:w-24 md:h-24 rounded-2xl object-cover shadow-sm border-2 border-white shrink-0" 
            />
            <div class="space-y-1.5 flex-1">
              <h3 class="text-2xl font-black text-slate-900 font-heading">Raghav Chakravarthy</h3>
              <p class="text-xs font-black uppercase tracking-wider text-sky-600 font-heading">Co-Founder</p>
              <p class="text-slate-700 text-sm font-semibold leading-relaxed pt-1">
                National quizmaster, TEDx speaker, and education innovator building India's largest curiosity ecosystem. Dedicated to transforming learning into an active sport driven by questioning and real-world quests.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 3. SUPPORT (INVESTORS & PARTNERS): FIXED GRID -->
    <section id="investors" class="py-14 bg-[#E8F6FD] border-t border-b border-sky-100 relative w-full">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 md:px-12 space-y-8">
        
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <span class="px-3.5 py-1 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase font-heading shadow-sm">
            Supported By
          </span>
          <h2 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight font-heading">
            Backed &amp; Supported by Industry Pioneers.
          </h2>
        </div>

        <!-- Fixed 3-Column Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-2">
          {INVESTORS_ADVISORS.map((inv) => (
            <div class="p-6 rounded-3xl bg-white border border-slate-200/80 shadow-sm space-y-3 hover:shadow-md hover:-translate-y-1 transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-3">
                  <span 
                    class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase text-white font-heading shadow-sm inline-block"
                    style={`background-color: ${inv.color};`}
                  >
                    {inv.badge}
                  </span>
                  <div class="w-10 h-10 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center p-2 shadow-sm shrink-0">
                    <img src={inv.logo} alt={inv.name} class="w-full h-full object-contain" onerror="this.style.display='none'" />
                  </div>
                </div>
                <h3 class="text-lg font-black text-slate-900 font-heading leading-tight pt-3">{inv.name}</h3>
                <p class="text-slate-600 text-xs font-semibold mt-1 leading-snug">
                  {inv.role}
                </p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 4. MEET QT MASCOT SECTION -->
    <section id="meet-qt" class="py-12 md:py-16 bg-[#FFFDF5] relative w-full px-4 sm:px-8 md:px-12">
      <div class="max-w-7xl mx-auto">
        
        <div class="bg-[#FFF8E1] rounded-3xl p-8 md:p-12 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-10 items-center w-full border border-amber-200/60">
          
          <!-- Left: Mascot Story -->
          <div class="lg:col-span-7 space-y-6">
            <div class="space-y-2">
              <span class="px-3.5 py-1 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase font-heading shadow-sm">
                MEET QT!
              </span>
              <h2 class="text-3xl md:text-5xl font-black text-slate-900 font-heading leading-tight">
                Meet QT, our Qurious cat.
              </h2>
            </div>

            <p class="text-slate-800 text-base md:text-lg font-semibold leading-relaxed">
              Inspired by the idea of the ever-Qurious cat, QT embodies the joy of exploring, questioning, and discovering. Unlike old superstitions, QT&apos;s all about luck, fun and sparking Quriosity wherever she goes.
            </p>

            <div class="pt-2">
              <QTAnimatedPlayer client:visible size="lg" />
            </div>
          </div>

          <!-- Right: QT Downloads -->
          <div class="lg:col-span-5 space-y-4">
            <div class="text-left space-y-1">
              <h3 class="text-2xl font-black text-slate-900 font-heading">
                QT for your everyday!
              </h3>
              <p class="text-xs font-bold text-slate-600 font-heading">Download official stickers &amp; emojis:</p>
            </div>

            <div class="flex flex-col gap-2.5 w-full sm:max-w-xs">
              <a 
                href="/assets/qt-sticker-pack.zip" 
                download
                class="px-5 py-3 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center justify-between gap-4 group"
              >
                <span>QT Sticker pack</span>
                <svg class="w-3.5 h-3.5 fill-current text-slate-950 group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              </a>

              <a 
                href="/assets/qt-emojis.zip" 
                download
                class="px-5 py-3 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center justify-between gap-4 group"
              >
                <span>QT Emojis</span>
                <svg class="w-3.5 h-3.5 fill-current text-slate-950 group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              </a>

              <a 
                href="/assets/qt-gifs.zip" 
                download
                class="px-5 py-3 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center justify-between gap-4 group"
              >
                <span>QT Gifs</span>
                <svg class="w-3.5 h-3.5 fill-current text-slate-950 group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 5. OUR TEAM: INTERACTIVE TEAM SHOWCASE -->
    <section id="our-team" class="py-16 md:py-20 bg-[#FFFDF5] relative w-full px-4 sm:px-8 md:px-12">
      <div class="w-full">
        <InteractiveTeamShowcase client:visible />
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
