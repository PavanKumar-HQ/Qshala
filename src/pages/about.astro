---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';
import QTAnimatedPlayer from '../components/QTAnimatedPlayer';
import InteractiveTeamShowcase from '../components/InteractiveTeamShowcase';

const INVESTORS_ADVISORS = [
  {
    name: "Rainmatter Foundation",
    category: "Impact & Climate Partner",
    description: "Supporting socratic environmental learning for 100,000+ students.",
    color: "#75B543",
    badge: "Impact Partner",
    logo: "https://www.google.com/s2/favicons?domain=rainmatter.org&sz=128"
  },
  {
    name: "Axilor Ventures",
    category: "Accelerator",
    description: "Backing QShala's scalable EdTech curiosity methodology.",
    color: "#30B2E7",
    badge: "Accelerator",
    logo: "https://www.google.com/s2/favicons?domain=axilor.com&sz=128"
  },
  {
    name: "Mindhouse & Angels",
    category: "Angel Investors",
    description: "Guided by leaders from India's top consumer tech ecosystems.",
    color: "#FDB913",
    badge: "Angel Backing",
    logo: "https://www.google.com/s2/favicons?domain=shyft.co&sz=128"
  },
  {
    name: "K-12 Advisory Council",
    category: "Academic Council",
    description: "Former principals and curriculum directors from CBSE, ICSE & IB schools.",
    color: "#9333EA",
    badge: "Academic Board",
    logo: "https://ui-avatars.com/api/?name=K-12&background=9333EA&color=fff&size=100"
  }
];
---

<BaseLayout title="About Us | QShala - India's Curiosity Company">
  <Navbar />

  <main class="flex-grow pt-28 pb-20 overflow-x-hidden bg-[#FFFDF5]">

    <!-- 1. HERO: OPEN EDITORIAL MISSION -->
    <section class="py-12 md:py-16 relative w-full px-4 sm:px-8 md:px-12">
      <!-- Ambient Glowing Orbs -->
      <div class="absolute top-10 left-1/4 w-96 h-96 bg-[#30B2E7]/15 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
      <div class="absolute top-40 right-1/4 w-96 h-96 bg-[#FDB913]/20 rounded-full blur-3xl pointer-events-none animate-pulse"></div>

      <div class="w-full relative z-10">
        <div class="text-center max-w-4xl mx-auto space-y-6">
          <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white border border-slate-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FDB913] animate-ping"></span>
            <span class="text-xs font-black uppercase tracking-wider font-heading text-slate-800">
              Our Story &amp; Brand Philosophy
            </span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
            We Believe <span class="text-[#30B2E7]">Curiosity</span> is the Greatest Superpower.
          </h1>

          <p class="text-slate-700 text-lg sm:text-xl font-semibold max-w-3xl mx-auto leading-relaxed">
            In a world obsessed with standard answers and test marks, QShala was born with one simple goal: <span class="text-[#75B543] font-black underline decoration-[#75B543]/40 decoration-4">&ldquo;Growth via Curiosity.&rdquo;</span>
          </p>

        </div>
      </div>
    </section>

    <!-- 2. FOUNDER STORY: OPEN EDITORIAL STORYLINE -->
    <section id="founder-story" class="py-16 md:py-20 bg-[#FFF8E1] relative w-full px-4 sm:px-8 md:px-12">
      <div class="w-full space-y-12">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div>
            <span class="px-3.5 py-1.5 rounded-full bg-white text-slate-800 font-black text-xs uppercase tracking-wider font-heading shadow-sm border border-slate-200">
              Est. 2014
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center w-full">
          
          <!-- Story Narrative Text -->
          <div class="lg:col-span-7 space-y-6">
            <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-heading leading-snug">
              &ldquo;Why does learning stop being fun when kids enter the classroom?&rdquo;
            </h3>
            
            <p class="text-slate-700 text-base leading-relaxed font-semibold">
              In 2014, two national-level quizmasters and TEDx speakers—<strong>Sachin Ravi</strong> and <strong>Raghav Chakravarthy</strong>—noticed a striking pattern. While young children naturally ask hundreds of questions a day, traditional schooling slowly turns off that spark.
            </p>
            
            <p class="text-slate-700 text-base leading-relaxed font-semibold">
              They started QShala to prove that learning shouldn&apos;t be about memorizing static facts for marks. Instead, it should be an active, socratic sport—full of stories, curiosity clubs, real-world current affairs, and friendly team quests.
            </p>
          </div>

          <!-- Open Founders Stage -->
          <div class="lg:col-span-5 space-y-6">
            <div class="flex items-center gap-5 p-5 rounded-2xl bg-white/80 border border-slate-200 shadow-sm">
              <img src="https://ui-avatars.com/api/?name=Sachin+Ravi&background=FDB913&color=fff&size=200" alt="Sachin Ravi" class="w-16 h-16 rounded-full object-cover shadow-sm border-2 border-white" />
              <div>
                <h4 class="text-lg font-black text-slate-900 mt-1 font-heading">Sachin Ravi</h4>
                <p class="text-xs text-slate-600 font-medium">Co-Founder, Storyteller &amp; Quizmaster</p>
              </div>
            </div>

            <div class="flex items-center gap-5 p-5 rounded-2xl bg-white/80 border border-slate-200 shadow-sm">
              <img src="https://ui-avatars.com/api/?name=Raghav+Chakravarthy&background=30B2E7&color=fff&size=200" alt="Raghav Chakravarthy" class="w-16 h-16 rounded-full object-cover shadow-sm border-2 border-white" />
              <div>
                <h4 class="text-lg font-black text-slate-900 mt-1 font-heading">Raghav Chakravarthy</h4>
                <p class="text-xs text-slate-600 font-medium">Co-Founder, Executive &amp; Education Strategist</p>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 3. MEET QT MASCOT SECTION (FULL PAGE EDGE-TO-EDGE FIT) -->
    <section id="meet-qt" class="py-12 md:py-16 bg-[#FFFDF5] relative w-full px-4 sm:px-8 md:px-12">
      <div class="w-full">
        
        <!-- Soft rounded cream background matching client brand guidelines (Full Page Fit) -->
        <div class="bg-[#FFF5D6] rounded-3xl p-8 md:p-12 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-10 items-center w-full border-2 border-slate-900/10">
          
          <!-- Left: Mascot Story -->
          <div class="lg:col-span-7 space-y-6">
            <div class="space-y-2">
              <span class="px-3.5 py-1 rounded-full bg-[#FDB913] text-black font-black text-xs uppercase font-heading border border-slate-900/20">
                MEET QT!
              </span>
              <h2 class="text-3xl md:text-5xl font-black text-slate-900 font-heading leading-tight">
                Meet QT, our mischievously curious black cat!
              </h2>
            </div>

            <p class="text-slate-800 text-base md:text-lg font-semibold leading-relaxed">
              Inspired by the idea of the ever-curious cat, QT embodies the joy of exploring, questioning, and discovering. Unlike old superstitions, QT&apos;s all about luck, fun and sparking curiosity wherever she goes.
            </p>

            <div class="pt-2 flex items-center gap-4">
              <QTAnimatedPlayer client:visible mode="playing" size="md" fps={8} />
              <div class="text-xs font-bold text-slate-700 font-heading">
                Official QShala Mascot &bull; Ever-Curious Being
              </div>
            </div>
          </div>

          <!-- Right: QT Downloads -->
          <div class="lg:col-span-5 space-y-4">
            <div class="text-left space-y-1">
              <h3 class="text-2xl font-black text-slate-900 font-heading">
                QT for your everyday!
              </h3>
              <p class="text-xs font-bold text-slate-600 font-heading">Download official stickers &amp; emojis:</p>
            </div>

            <div class="flex flex-col gap-3">
              <a 
                href="/assets/qt-sticker-pack.zip" 
                download
                class="px-6 py-3.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm font-heading border-2 border-slate-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-0.5 transition-all flex items-center justify-between group"
              >
                <span>QT Sticker pack</span>
                <svg class="w-4 h-4 fill-current text-black group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              </a>

              <a 
                href="/assets/qt-emojis.zip" 
                download
                class="px-6 py-3.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm font-heading border-2 border-slate-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-0.5 transition-all flex items-center justify-between group"
              >
                <span>QT Emojis</span>
                <svg class="w-4 h-4 fill-current text-black group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              </a>

              <a 
                href="/assets/qt-gifs.zip" 
                download
                class="px-6 py-3.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm font-heading border-2 border-slate-900 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-0.5 transition-all flex items-center justify-between group"
              >
                <span>QT Gifs</span>
                <svg class="w-4 h-4 fill-current text-black group-hover:translate-y-0.5 transition-transform" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 4. SUPPORT (INVESTORS & PARTNERS): OPEN HORIZONTAL STRIP -->
    <section id="investors" class="py-14 bg-[#E8F6FD] border-t border-b border-sky-200/60 relative w-full overflow-hidden">
      <div class="w-full space-y-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 px-4 sm:px-8 md:px-12">
          <div>
            <span class="px-3.5 py-1 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase font-heading">
              Supported By
            </span>
            <h2 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight mt-2 font-heading">
              Backed &amp; Supported by Industry Pioneers.
            </h2>
          </div>
        </div>

        <div class="marquee-container relative w-full overflow-hidden">
          <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-16 md:w-32 z-10 bg-gradient-to-r from-[#E8F6FD] to-transparent"></div>
          <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-16 md:w-32 z-10 bg-gradient-to-l from-[#E8F6FD] to-transparent"></div>
          
          <div class="marquee-track flex gap-4 w-max px-4">
            {[...INVESTORS_ADVISORS, ...INVESTORS_ADVISORS, ...INVESTORS_ADVISORS].map((inv) => (
              <div class="p-5 rounded-2xl bg-white/80 border border-sky-100 shadow-sm space-y-3 w-72 shrink-0">
                <div class="flex items-start justify-between gap-2">
                  <span 
                    class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase text-white font-heading inline-block"
                    style={`background-color: ${inv.color};`}
                  >
                    {inv.badge}
                  </span>
                  <img src={inv.logo} alt={inv.name} class="w-8 h-8 object-contain rounded bg-white shadow-sm" onerror="this.style.display='none'" />
                </div>
                <h3 class="text-lg font-black text-slate-900 font-heading leading-tight pt-1">{inv.name}</h3>
                <p class="text-slate-600 text-xs font-medium leading-relaxed">
                  {inv.description}
                </p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <style>
      .marquee-track {
        animation: scroll-left-investors 25s linear infinite;
      }
      .marquee-container:hover .marquee-track {
        animation-play-state: paused;
      }
      @keyframes scroll-left-investors {
        0% { transform: translateX(0); }
        100% { transform: translateX(calc(-100% / 3)); }
      }
    </style>

    <!-- 5. OUR TEAM: INTERACTIVE TEAM SHOWCASE -->
    <section id="our-team" class="py-16 md:py-20 bg-[#FFFDF5] relative w-full px-4 sm:px-8 md:px-12">
      <div class="w-full">
        <InteractiveTeamShowcase client:visible />
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
