---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const INVESTORS_ADVISORS = [
  {
    name: "Rainmatter Foundation",
    category: "Impact & Climate Education Partner",
    description: "Supporting QShala's mission to take socratic learning and environmental curiosity to 100,000+ school students.",
    color: "#75B543",
    bg: "#EDF7E5",
    badge: "Impact Partner"
  },
  {
    name: "Axilor Ventures",
    category: "Early Stage Accelerator",
    description: "Backing QShala's scalable EdTech methodology and school community engagement platforms.",
    color: "#30B2E7",
    bg: "#E8F6FD",
    badge: "Accelerator"
  },
  {
    name: "Mindhouse & Industry Angels",
    category: "Angel Investors & EdTech Leaders",
    description: "Guided by founders and executives from India's leading consumer tech, media, and education ecosystems.",
    color: "#FDB913",
    bg: "#FFF8E1",
    badge: "Angel Backing"
  },
  {
    name: "K-12 Advisory Council",
    category: "Academic & Pedagogical Council",
    description: "Composed of former principals and curriculum directors from top ICSE, CBSE, and IB schools across India.",
    color: "#A855F7",
    bg: "#F3E8FF",
    badge: "Academic Board"
  }
];

const TEAM_MEMBERS = [
  {
    name: "Sachin Ravi",
    role: "Co-Founder & Chief Storyteller",
    bio: "Celebrated quizmaster, TEDx speaker, and co-creator of QShala. Passionate about replacing rote learning with socratic wonder.",
    variant: "sherlock" as const,
    color: "#FDB913",
    bg: "#FFF8E1",
    tag: "Founder"
  },
  {
    name: "Raghavan A.",
    role: "Co-Founder & Chief Executive",
    bio: "National level quizzer and education strategist building India's largest curiosity ecosystem for 250+ schools.",
    variant: "quizzing" as const,
    color: "#30B2E7",
    bg: "#E8F6FD",
    tag: "Founder"
  },
  {
    name: "Preeti K.",
    role: "Head of Curriculum & Socratic Learning",
    bio: "Former educator with 12+ years designing socratic questioning frameworks and 21st-century skill modules.",
    variant: "reading" as const,
    color: "#75B543",
    bg: "#EDF7E5",
    tag: "Curriculum"
  },
  {
    name: "Rohan M.",
    role: "Chief Quizmaster & Content Lead",
    bio: "Has hosted over 500+ live trivia events and written thousands of brain-teasing questions for kids & corporate teams.",
    variant: "idea" as const,
    color: "#A855F7",
    bg: "#F3E8FF",
    tag: "Content"
  },
  {
    name: "Divya S.",
    role: "Lead, School Partnerships",
    bio: "Empowering 250+ principal partners and 10,000+ teachers to integrate weekly curiosity clubs seamlessly into school hours.",
    variant: "curious" as const,
    color: "#EC4899",
    bg: "#FCE7F3",
    tag: "Partnerships"
  },
  {
    name: "Karthik R.",
    role: "Head of Gamified Tech & Platform",
    bio: "Architecting interactive buzzers, daily quiz engines, and real-time leaderboards that delight thousands of daily learners.",
    variant: "professional" as const,
    color: "#30B2E7",
    bg: "#E8F6FD",
    tag: "Technology"
  },
  {
    name: "Ananya M.",
    role: "Senior Instructional Designer & QT Artist",
    bio: "Bringing QT mascot to life across activity decks, storybooks, and visual learning journals.",
    variant: "holding_money" as const,
    color: "#FDB913",
    bg: "#FFF8E1",
    tag: "Design"
  },
  {
    name: "Vikram P.",
    role: "Corporate Engagement Lead",
    bio: "Designing high-octane team offsites, brand trivia leagues, and hybrid culture circles for Fortune 500 companies.",
    variant: "trophy" as const,
    color: "#75B543",
    bg: "#EDF7E5",
    tag: "Corporate"
  }
];
---

<BaseLayout title="About Us | QShala - India's Curiosity Company">
  <Navbar />

  <main class="flex-grow pt-28 pb-20 overflow-x-hidden bg-[#FFFDF5]">

    <!-- 1. HERO: OUR MISSION & PHILOSOPHY -->
    <section class="py-12 md:py-16 relative">
      <!-- Ambient Orbs -->
      <div class="absolute top-10 left-1/4 w-80 h-80 bg-[#30B2E7]/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute top-40 right-1/4 w-80 h-80 bg-[#FDB913]/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center max-w-4xl mx-auto space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FDB913] animate-pulse"></span>
            <span class="text-xs font-black uppercase tracking-wider font-heading text-slate-900">
              Our Story &amp; Brand Philosophy
            </span>
          </div>

          <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
            We Believe <span class="text-[#30B2E7] underline decoration-[#30B2E7]/40 decoration-4">Curiosity</span> is the Greatest Superpower.
          </h1>

          <p class="text-slate-700 text-lg sm:text-xl font-semibold max-w-3xl mx-auto leading-relaxed">
            In a world obsessed with standard answers and test marks, QShala was born with one simple goal: <span class="text-[#75B543] font-black underline decoration-[#75B543]/40 decoration-4">&ldquo;Growth via Curiosity.&rdquo;</span>
          </p>

          <!-- 3 Brand Guideline Pillars -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-8 text-left">
            <div class="p-6 rounded-3xl bg-[#E8F6FD] border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] space-y-2">
              <div class="w-10 h-10 rounded-xl bg-[#30B2E7] text-white flex items-center justify-center font-black border-2 border-black font-heading">
                01
              </div>
              <h3 class="text-xl font-black text-slate-900 font-heading">Qurious Sky (#30B2E7)</h3>
              <p class="text-xs text-slate-700 font-medium leading-relaxed">
                Inspiring boundless wonder and socratic exploration for school-going children and young minds.
              </p>
            </div>

            <div class="p-6 rounded-3xl bg-[#FFF8E1] border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] space-y-2">
              <div class="w-10 h-10 rounded-xl bg-[#FDB913] text-black flex items-center justify-center font-black border-2 border-black font-heading">
                02
              </div>
              <h3 class="text-xl font-black text-slate-900 font-heading">Joy of Quest (#FDB913)</h3>
              <p class="text-xs text-slate-700 font-medium leading-relaxed">
                Transforming learning into an adventurous quest full of excitement, storytelling, and fun.
              </p>
            </div>

            <div class="p-6 rounded-3xl bg-[#EDF7E5] border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] space-y-2">
              <div class="w-10 h-10 rounded-xl bg-[#75B543] text-white flex items-center justify-center font-black border-2 border-black font-heading">
                03
              </div>
              <h3 class="text-xl font-black text-slate-900 font-heading">Always Questioning (#75B543)</h3>
              <p class="text-xs text-slate-700 font-medium leading-relaxed">
                Building a compassionate, engaged citizenry equipped with 21st-century critical thinking.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 2. FOUNDER STORY SECTION -->
    <section id="founder-story" class="py-14 bg-[#FFF8E1] border-t-2 border-b-2 border-black relative">
      <div class="max-w-7xl mx-auto px-6 space-y-12">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
          <div class="space-y-2">
            <span class="px-4 py-1.5 rounded-full bg-[#FDB913] text-black font-black text-xs uppercase border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] font-heading">
              The Journey
            </span>
            <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
              The Founder Story: From Quizmasters to Pioneers.
            </h2>
          </div>
          <div class="text-xs font-black text-slate-700 uppercase tracking-wider font-heading">
            Established 2014 &bull; Bengaluru, India
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
          
          <!-- Story Content Card -->
          <div class="lg:col-span-7 bg-white rounded-3xl p-8 md:p-10 border-2 border-black shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] space-y-6 flex flex-col justify-between">
            <div class="space-y-4">
              <h3 class="text-2xl font-black text-slate-900 font-heading">
                &ldquo;Why does learning stop being fun when kids enter the classroom?&rdquo;
              </h3>
              <p class="text-slate-700 text-base leading-relaxed font-medium">
                In 2014, two national-level quizmasters and TEDx speakers—<strong>Sachin Ravi</strong> and <strong>Raghavan A.</strong>—noticed a striking pattern across India. While young children naturally ask hundreds of questions a day, traditional rote-memorization schooling slowly systematically turns off that spark.
              </p>
              <p class="text-slate-700 text-base leading-relaxed font-medium">
                They started QShala to prove that general knowledge shouldn&apos;t be about memorizing static encyclopedia facts for marks. Instead, it should be an active, socratic sport—full of stories, curiosity clubs, real-world current affairs, and friendly team quests.
              </p>
              <p class="text-slate-700 text-base leading-relaxed font-medium">
                Over the past decade, QShala has grown from weekend curiosity circles into an ecosystem partnering with <strong>250+ premier K-12 schools</strong> and <strong>80+ global corporates</strong>, impacting over 150,000+ learners across 18+ cities.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-[#FFF8E1] border-2 border-black flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-[#FDB913] border-2 border-black flex items-center justify-center font-black text-lg font-heading shrink-0">
                &ldquo;
              </div>
              <div class="text-xs font-bold text-slate-900 leading-snug">
                &ldquo;Our vision is simple: to nurture an empathetic, highly curious generation that never stops asking 'Why?'&rdquo;
                <div class="text-[11px] font-black text-slate-600 mt-1 uppercase font-heading">— Sachin &amp; Raghavan, Co-Founders</div>
              </div>
            </div>
          </div>

          <!-- Founders Visual Stage -->
          <div class="lg:col-span-5 flex flex-col gap-6">
            <div class="bg-[#E8F6FD] rounded-3xl p-6 border-2 border-black shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] flex items-center gap-6">
              <QTMascot client:visible variant="sherlock" size="lg" />
              <div>
                <span class="px-2.5 py-0.5 rounded-full bg-[#30B2E7] text-white font-black text-[10px] uppercase border border-black font-heading">Co-Founder</span>
                <h4 class="text-xl font-black text-slate-900 mt-1 font-heading">Sachin Ravi</h4>
                <p class="text-xs text-slate-700 font-medium">Storyteller &amp; Quizmaster</p>
              </div>
            </div>

            <div class="bg-[#EDF7E5] rounded-3xl p-6 border-2 border-black shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] flex items-center gap-6">
              <QTMascot client:visible variant="quizzing" size="lg" />
              <div>
                <span class="px-2.5 py-0.5 rounded-full bg-[#75B543] text-white font-black text-[10px] uppercase border border-black font-heading">Co-Founder</span>
                <h4 class="text-xl font-black text-slate-900 mt-1 font-heading">Raghavan A.</h4>
                <p class="text-xs text-slate-700 font-medium">Executive &amp; Education Strategist</p>
              </div>
            </div>

            <div class="bg-white rounded-3xl p-6 border-2 border-black shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] text-center space-y-2">
              <div class="text-3xl font-black text-slate-900 font-heading">10+ Years of Impact</div>
              <p class="text-xs font-bold text-slate-600">Empowering curiosity from Grade 1 classrooms to Fortune 500 boardrooms.</p>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 3. MEET QT MASCOT SECTION (MATCHING EXACT CLIENT BRAND SCREENSHOT!) -->
    <section id="meet-qt" class="py-14 bg-[#FFFDF5] relative">
      <div class="max-w-7xl mx-auto px-6">
        
        <!-- Outer Card matching client brand guideline screenshot -->
        <div class="bg-[#FFF5D6] rounded-[2.5rem] p-8 md:p-12 border-3 border-black shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Left: Mascot Intro -->
          <div class="lg:col-span-7 space-y-6">
            <div class="space-y-3">
              <span class="px-4 py-1.5 rounded-full bg-[#FDB913] text-black font-black text-xs uppercase border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] font-heading">
                Meet QT!
              </span>
              <h2 class="text-3xl md:text-5xl font-black text-slate-900 font-heading leading-tight">
                Meet QT, Our Mischievously Curious Black Cat!
              </h2>
            </div>

            <p class="text-slate-800 text-base md:text-lg font-semibold leading-relaxed">
              Inspired by the idea of the ever-curious cat and the letter &apos;Q&apos;, QT embodies the joy of exploring, questioning, and discovering. Unlike old superstitions, QT&apos;s all about luck, fun, and sparking curiosity wherever she goes.
            </p>

            <!-- Mascot Illustration Placeholder Stage -->
            <div class="pt-2 flex items-center gap-6">
              <div class="p-4 rounded-2xl bg-white border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] inline-flex items-center gap-3">
                <QTMascot client:visible variant="curious" size="md" />
                <div>
                  <div class="font-black text-slate-900 text-xs font-heading">Ever-Curious Cat</div>
                  <div class="text-[10px] text-slate-600 font-bold">Official QShala Mascot</div>
                </div>
              </div>

              <div class="hidden sm:flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-[#30B2E7]"></span>
                <span class="w-3 h-3 rounded-full bg-[#FDB913]"></span>
                <span class="w-3 h-3 rounded-full bg-[#75B543]"></span>
              </div>
            </div>
          </div>

          <!-- Right: QT Download Action Buttons (Matching Screenshot) -->
          <div class="lg:col-span-5 bg-white/80 backdrop-blur-sm rounded-3xl p-8 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] text-center space-y-6">
            <div>
              <h3 class="text-2xl md:text-3xl font-black text-slate-900 font-heading">
                QT for your everyday!
              </h3>
              <p class="text-xs font-bold text-slate-600 mt-1">Download official brand stickers &amp; emojis:</p>
            </div>

            <div class="flex flex-col gap-3 max-w-xs mx-auto">
              <a 
                href="/assets/qt-sticker-pack.zip" 
                download
                class="px-6 py-3.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] font-heading transition-all flex items-center justify-between group"
              >
                <span>QT Sticker pack</span>
                <span class="text-base group-hover:translate-y-0.5 transition-transform">&darr;</span>
              </a>

              <a 
                href="/assets/qt-emojis.zip" 
                download
                class="px-6 py-3.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] font-heading transition-all flex items-center justify-between group"
              >
                <span>QT Emojis</span>
                <span class="text-base group-hover:translate-y-0.5 transition-transform">&darr;</span>
              </a>

              <a 
                href="/assets/qt-gifs.zip" 
                download
                class="px-6 py-3.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] font-heading transition-all flex items-center justify-between group"
              >
                <span>QT Gifs</span>
                <span class="text-base group-hover:translate-y-0.5 transition-transform">&darr;</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- 4. SUPPORT (INVESTORS & PARTNERS) SECTION -->
    <section id="investors" class="py-14 bg-[#E8F6FD] border-t-2 border-b-2 border-black relative">
      <div class="max-w-7xl mx-auto px-6 space-y-12">
        
        <div class="text-center max-w-3xl mx-auto space-y-3">
          <span class="px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] font-heading">
            Supported By
          </span>
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
            Backed &amp; Supported by Industry Pioneers.
          </h2>
          <p class="text-slate-700 text-base font-semibold max-w-xl mx-auto">
            Prominent accelerators, impact foundations, and education leaders supporting QShala&apos;s vision.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {INVESTORS_ADVISORS.map((inv) => (
            <div 
              class="rounded-3xl p-6 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between transition-transform hover:-translate-y-1"
              style={`background-color: ${inv.bg};`}
            >
              <div class="space-y-3">
                <span 
                  class="px-3 py-1 rounded-full text-[10px] font-black uppercase text-white border border-black font-heading inline-block"
                  style={`background-color: ${inv.color};`}
                >
                  {inv.badge}
                </span>
                <h3 class="text-xl font-black text-slate-900 font-heading leading-tight">{inv.name}</h3>
                <div class="text-[11px] font-bold text-slate-700 uppercase tracking-wider">{inv.category}</div>
                <p class="text-slate-700 text-xs font-semibold leading-relaxed pt-1">
                  {inv.description}
                </p>
              </div>

              <div class="mt-6 pt-3 border-t border-slate-900/10 flex items-center justify-between text-[11px] font-black text-slate-900 font-heading">
                <span>Verified Partner</span>
                <span style={`color: ${inv.color}`}>&check;</span>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- 5. OUR TEAM SECTION (CURIOSITY CREW) -->
    <section id="our-team" class="py-14 bg-[#EDF7E5] border-b-2 border-black relative">
      <div class="max-w-7xl mx-auto px-6 space-y-12">
        
        <div class="text-center max-w-3xl mx-auto space-y-3">
          <span class="px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase border-2 border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] font-heading">
            Our Team
          </span>
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
            Meet the Curiosity Crew.
          </h2>
          <p class="text-slate-700 text-base font-semibold max-w-xl mx-auto">
            The storytellers, educators, quizmasters, and engineers bringing curiosity to life every single day.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {TEAM_MEMBERS.map((member) => (
            <div 
              class="rounded-3xl p-6 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col justify-between group transition-all hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
              style={`background-color: ${member.bg};`}
            >
              <div>
                <!-- Top Badge & Mascot Stage -->
                <div class="flex items-center justify-between mb-4">
                  <span 
                    class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase text-white border border-black font-heading"
                    style={`background-color: ${member.color};`}
                  >
                    {member.tag}
                  </span>
                  <div class="scale-75 origin-top-right">
                    <QTMascot client:visible variant={member.variant} size="sm" />
                  </div>
                </div>

                <!-- Info -->
                <h3 class="text-xl font-black text-slate-900 font-heading leading-tight">{member.name}</h3>
                <div class="text-xs font-bold text-slate-700 mt-0.5 mb-3">{member.role}</div>
                <p class="text-slate-700 text-xs font-medium leading-relaxed">
                  {member.bio}
                </p>
              </div>

              <!-- Bottom Accent -->
              <div class="mt-6 pt-3 border-t border-slate-900/10 flex items-center justify-between text-[10px] font-black text-slate-800 uppercase font-heading">
                <span>QShala Crew</span>
                <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${member.color}`}></span>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
