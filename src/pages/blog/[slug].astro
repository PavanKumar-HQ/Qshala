---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import QTMascot from '../../components/QTMascot';

export async function getStaticPaths() {
  const posts = [
    {
      slug: 'bangalore-inter-school-quriosity-cup-2026',
      title: 'Bangalore Inter-School Quriosity Cup 2026',
      category: 'Events',
      readTime: 'Photo Gallery',
      date: 'July 2026',
      isoDate: '2026-07-20T10:00:00+05:30',
      author: 'Sachin Ravi',
      authorRole: 'Co-Founder, National Quizmaster',
      summary: 'Over 1,200 student quizzers representing 64 schools competed across 4 adrenaline-pumping buzzer rounds at St. John\'s Auditorium.',
      color: '#FDB913',
      bg: 'bg-[#FFF8E1]',
      content: `
        <p class="text-lg text-slate-800 leading-relaxed font-semibold mb-6">
          The 2026 edition of the Bangalore Inter-School Quriosity Cup brought together over 1,200 enthusiastic student quizzers representing 64 premier K-12 schools across Bengaluru for a day of socratic deduction, team strategy, and high-energy quizzing.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">A Celebration of Inquiry Over Rote Memory</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          Unlike standard trivia championships that reward encyclopedic recall, the Quriosity Cup tested reasoning, lateral thinking, and collaborative hypothesis-testing. Finalist teams tackled multi-layered visual clues, reverse-engineering scientific discoveries and historical crossroads.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">Event Photo Access for Participants</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          All participating students, teachers, and parents can browse, view, and save event photographs below from the preliminary heats, stage rounds, and awards ceremony.
        </p>
      `,
      gallery: [
        { url: "https://images.unsplash.com/photo-1577896851231-70ef18881754?q=80&w=1200&auto=format&fit=crop", caption: "Packed auditorium cheering as the finalists took the stage" },
        { url: "https://images.unsplash.com/photo-1509062522246-3755977927d7?q=80&w=1200&auto=format&fit=crop", caption: "Team DPS East conferring during the socratic science round" },
        { url: "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=1200&auto=format&fit=crop", caption: "Quizmaster Sachin Ravi breaking down a trick history question" },
        { url: "https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=1200&auto=format&fit=crop", caption: "Audience questions and parent spot trivia giveaways" },
        { url: "https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=1200&auto=format&fit=crop", caption: "Trophy ceremony celebrating the 2026 championship winners" },
        { url: "https://images.unsplash.com/photo-1503676260728-1c00da094a0b?q=80&w=1200&auto=format&fit=crop", caption: "Hands shooting up across the middle-school tier" },
        { url: "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=1200&auto=format&fit=crop", caption: "Scoreboard update before the high-stakes final buzzer round" },
        { url: "https://images.unsplash.com/photo-1511895426328-dc8714191300?q=80&w=1200&auto=format&fit=crop", caption: "Students celebrating with QT mascot stickers and certificates" },
        { url: "https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=1200&auto=format&fit=crop", caption: "Principals and coordinators gathering for the closing keynote" },
        { url: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1200&auto=format&fit=crop", caption: "Group photo with participating school teams" }
      ]
    },
    {
      slug: 'national-corporate-trivia-summit',
      title: 'National Corporate Trivia League Finals',
      category: 'Events',
      readTime: 'Photo Gallery',
      date: 'June 2026',
      isoDate: '2026-06-25T10:00:00+05:30',
      author: 'Raghav Chakravarthy',
      authorRole: 'Co-Founder, Chief Quizmaster',
      summary: '48 corporate teams from Flipkart, Google, Wipro, TCS, and Amazon competed in high-octane live buzzer trivia at JW Marriott, Bengaluru.',
      color: '#FDB913',
      bg: 'bg-[#FFF8E1]',
      content: `
        <p class="text-lg text-slate-800 leading-relaxed font-semibold mb-6">
          The National Corporate Trivia League Finals hosted 48 corporate teams for a Friday evening of high-stakes buzzer rounds, team bonding, and lateral thinking challenges.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">Building Culture Through Gamified Camaraderie</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          Participating teams engaged in multi-tier rounds designed by QShala's experience team—spanning 90s pop culture, business brand lore, audio-visual mysteries, and rapid-fire buzzers.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">Corporate Event Photos</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          Browse and download photos from the team qualifiers, live buzzer clashes, and the final trophy celebration below.
        </p>
      `,
      gallery: [
        { url: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1200&auto=format&fit=crop", caption: "Engineering and HR teams collaborating on rapid-fire business trivia" },
        { url: "https://images.unsplash.com/photo-1511632765486-a01980e01a18?q=80&w=1200&auto=format&fit=crop", caption: "Cross-functional laughter during the brand lore audio round" },
        { url: "https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=1200&auto=format&fit=crop", caption: "Digital buzzers and live interactive leaderboard display" },
        { url: "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=1200&auto=format&fit=crop", caption: "Awards presented for best team chemistry and top trivia master" },
        { url: "https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=1200&auto=format&fit=crop", caption: "Networking dinner and post-event discussions" },
        { url: "https://images.unsplash.com/photo-1523240795612-9a054b0db644?q=80&w=1200&auto=format&fit=crop", caption: "Team high-fives as the winning answer was locked in" },
        { url: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=1200&auto=format&fit=crop", caption: "Quizmaster facilitating the rapid-fire championship clash" },
        { url: "https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=1200&auto=format&fit=crop", caption: "Audience participation round with over 300 spectators" },
        { url: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=1200&auto=format&fit=crop", caption: "Celebrating corporate learning and psychological safety" },
        { url: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1200&auto=format&fit=crop", caption: "All finalists gathering for the commemorative group snapshot" }
      ]
    },
    {
      slug: 'why-rote-learning-kills-quriosity',
      title: 'Why Rote Learning Kills Quriosity (And How to Fix It)',
      category: 'Blog',
      readTime: '5 min read',
      date: 'Aug 1, 2026',
      isoDate: '2026-08-01T10:00:00+05:30',
      author: 'Sachin Ravi',
      authorRole: 'Co-Founder, National Quizmaster',
      summary: 'Standard GK worksheets ask children to memorize facts without asking why. We explore socratic dialogue methods that unlock original thinking.',
      color: '#30B2E7',
      bg: 'bg-[#E8F6FD]',
      content: `
        <p class="text-lg text-slate-800 leading-relaxed font-semibold mb-6">
          For decades, classrooms across the world have operated on a simple transaction: the teacher dictates the answer, and the student memorizes it for the exam. While this rote-learning methodology is efficient for scoring marks, it actively kills a child's natural superpower—quriosity.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">The Danger of the "Correct Answer"</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          When we tell a child that the only thing that matters is getting the exact correct answer written down on a sheet of paper, we teach them to stop exploring the margins. Quriosity isn't about knowing the answer; it's about the journey of asking the question.
        </p>
        <blockquote class="border-l-4 border-[#30B2E7] pl-4 italic text-slate-800 font-semibold my-8 py-2 bg-slate-50 rounded-r-2xl pr-4">
          "If you teach a child facts, you prepare them for a trivia game. If you teach them how to ask questions, you prepare them for the real world."
        </blockquote>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">Entering the Socratic Circle</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          At QShala, our <a href="/schools" class="text-[#30B2E7] font-bold underline hover:text-[#258eb9]">Weekly Quriosity Clubs for K-12 Schools</a> utilize Socratic questioning. Instead of telling children that an octopus has three hearts, we ask: <em>"Why would a creature that swims in the deep ocean need three separate hearts?"</em> This forces the mind to work through systemic biology, pressure, and energy distribution.
        </p>
        <h3 class="text-xl font-black font-heading text-slate-900 mt-6 mb-3">Three Ways Parents Can Spark Socratic Dialogue:</h3>
        <ul class="list-disc pl-6 space-y-3 text-slate-700 font-medium mb-8">
          <li><strong>Never answer "I don't know" alone:</strong> Follow it up with, "Let's figure out how we can test that."</li>
          <li><strong>Ask "How do you know that?":</strong> Get children to explain the source of their facts.</li>
          <li><strong>Compare and contrast:</strong> Ask questions like, "How is a computer keyboard similar to a piano?" Explore more conversation starters in our <a href="/learn" class="text-[#30B2E7] font-bold underline hover:text-[#258eb9]">Sunday Curiosity Club & Question Bank</a>.</li>
        </ul>
      `
    },
    {
      slug: 'curious-dinner-table',
      title: "How to Build a 'Curious Dinner Table' for Your Kids",
      category: 'Blog',
      readTime: '4 min read',
      date: 'July 28, 2026',
      isoDate: '2026-07-28T10:00:00+05:30',
      author: 'Raghav Chakravarthy',
      authorRole: 'Co-Founder, Chief Quizmaster',
      summary: 'Three simple question prompts and game mechanics that swap screen time for active discussion during family dinners.',
      color: '#75B543',
      bg: 'bg-[#EDF7E5]',
      content: `
        <p class="text-lg text-slate-800 leading-relaxed font-semibold mb-6">
          The dinner table is the most underutilized educational space in modern households. With screens resting beside plates, families eat in parallel silence. By introducing gamified quriosity, you can turn dinners into hubs of discovery.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">Swapping "How was your day?" for "What did you ask?"</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          Standard questions yield standard answers ("Good", "Fine", "Nothing"). Instead, Nobel laureate Isidor Rabi's mother used to ask him: <em>"Did you ask a good question today, Izzy?"</em> Shifting the focus to inquiry changes what kids look out for during the day.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">The Dinner Table Quiz Game</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          You don't need a buzzer system to play. Use QShala's <a href="/shop" class="text-[#75B543] font-bold underline hover:text-[#5d9434]">The Great Quriosity Deck (100 Flash Cards)</a>: pick one card, read the mystery, and let everyone guess. The goal isn't to get it right; it's to come up with the most creative theory. You can also organize larger sessions through our <a href="/communities" class="text-[#75B543] font-bold underline hover:text-[#5d9434]">Community & Family Game Nights</a>.
        </p>
        <h3 class="text-xl font-black font-heading text-slate-900 mt-6 mb-3">Quick Prompts to Try Tonight:</h3>
        <ul class="list-disc pl-6 space-y-3 text-slate-700 font-medium mb-8">
          <li>"Why do you think windows are made of glass and not transparent plastic?"</li>
          <li>"If you had to live in space for a year, what is the one household object you would miss the most?"</li>
          <li>"How do you think birds know where to fly when winter comes?"</li>
        </ul>
      `
    },
    {
      slug: 'gamification-modern-corporate-learning',
      title: 'Gamification: The Secret Weapon of Modern Corporate L&D',
      category: 'Blog',
      readTime: '6 min read',
      date: 'July 15, 2026',
      isoDate: '2026-07-15T10:00:00+05:30',
      author: 'Sachin Ravi',
      authorRole: 'Co-Founder, National Quizmaster',
      summary: 'How leading startups use live interactive buzzers and case-study tournaments to boost cross-team engagement by over 90%.',
      color: '#FDB913',
      bg: 'bg-[#FFF8E1]',
      content: `
        <p class="text-lg text-slate-800 leading-relaxed font-semibold mb-6">
          Traditional corporate slide decks are where employee engagement goes to die. To truly align teams and build shared culture, leading HR managers are turning to high-stakes, interactive gamification.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">Why Buzzers Work Better Than Slides</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          In a live gamified setup (like <a href="/companies" class="text-[#FDB913] font-bold underline hover:text-amber-600">QShala's Corporate Trivia Nights</a>), employees aren't passively receiving information. They are competing, collaborating, and retrieving facts in real-time. This triggers dopamine release, making learning stick.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">Decreasing Employee Attrition</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          Our data across 80+ enterprise partners shows that shared play builds psychological safety and cohesion. Teams that laugh and solve riddles together build stronger cross-functional relationships, contributing directly to a measurable decrease in workplace disconnect. Explore customized offsites via our <a href="/custom" class="text-[#FDB913] font-bold underline hover:text-amber-600">Custom Brand & Offsite Experiences</a>.
        </p>
      `
    },
    {
      slug: 'socratic-mindset-future-ready-kids',
      title: 'How Socratic Questioning Builds Future-Ready Mindsets in Children',
      category: 'Blog',
      readTime: '5 min read',
      date: 'Aug 5, 2026',
      isoDate: '2026-08-05T10:00:00+05:30',
      author: 'Raghav Chakravarthy',
      authorRole: 'Co-Founder, Chief Quizmaster',
      summary: 'In an era of instant answers, the skill of the 21st century is framing the right question. Learn how socratic loops build resilient problem solvers.',
      color: '#30B2E7',
      bg: 'bg-[#E8F6FD]',
      content: `
        <p class="text-lg text-slate-800 leading-relaxed font-semibold mb-6">
          When information is abundant, memory ceases to be a competitive advantage. The real superpower for the next generation is critical inquiry—the ability to look at complex systems, test assumptions, and ask socratic questions.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">The Socratic Questioning Loop</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          Socratic questioning breaks down big concepts into small, self-discovered logical leaps. Instead of teaching environmental conservation as a lecture, we guide students to deduce why tree cover regulates city temperature through guided questioning in our <a href="/schools" class="text-[#30B2E7] font-bold underline hover:text-[#258eb9]">Public Speaking & Socratic Debate School Modules</a>.
        </p>
      `
    },
    {
      slug: 'ai-and-quriosity-asking-right-questions',
      title: 'AI & Quriosity: Teaching Children How to Ask the Right Questions',
      category: 'Blog',
      readTime: '6 min read',
      date: 'Aug 3, 2026',
      isoDate: '2026-08-03T10:00:00+05:30',
      author: 'Sachin Ravi',
      authorRole: 'Co-Founder, National Quizmaster',
      summary: 'Large Language Models give immediate answers. Here is why prompt drafting and critical quriosity are the essential skills for young minds today.',
      color: '#75B543',
      bg: 'bg-[#EDF7E5]',
      content: `
        <p class="text-lg text-slate-800 leading-relaxed font-semibold mb-6">
          Artificial Intelligence can summarize textbooks in seconds, but it only responds to human intent. Teaching kids how to formulate precise, creative questions is now the highest form of digital literacy.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">From Prompting to Insight</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          When students learn prompt framing with QShala, they discover that vague questions get generic answers, while deep, nuanced questions reveal fascinating insights. Practice daily question formulations on the <a href="/learn" class="text-[#75B543] font-bold underline hover:text-[#5d9434]">QShala Daily Quiz Platform</a>.
        </p>
      `
    },
    {
      slug: 'daily-news-quizzing-critical-thinking',
      title: 'The Power of Daily News Quizzing for School Students',
      category: 'Blog',
      readTime: '4 min read',
      date: 'Aug 2, 2026',
      isoDate: '2026-08-02T10:00:00+05:30',
      author: 'Raghav Chakravarthy',
      authorRole: 'Co-Founder, Chief Quizmaster',
      summary: 'How reading current events through interactive quiz questions turns passive headlines into active global awareness.',
      color: '#FDB913',
      bg: 'bg-[#FFF8E1]',
      content: `
        <p class="text-lg text-slate-800 leading-relaxed font-semibold mb-6">
          Children often find traditional newspapers boring. But when global events are converted into intriguing riddles and photo puzzles, news reading becomes an addictive daily habit.
        </p>
        <h2 class="text-2xl font-black font-heading text-slate-900 mt-8 mb-4">Connecting News to Daily Life</h2>
        <p class="text-slate-700 leading-relaxed mb-6 font-medium">
          QShala Daily Quiz modules connect space missions, international trade, and scientific discoveries directly to topics taught in school textbooks. Discover our <a href="/schools" class="text-[#FDB913] font-bold underline hover:text-amber-600">GK & Current Affairs Storytelling Curriculum for Schools</a>.
        </p>
      `
    }
  ];

  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

const articleSchema = {
  "@type": "BlogPosting",
  "@id": `https://qshala.vercel.app/blog/${post.slug}#article`,
  "headline": post.title,
  "description": post.summary,
  "articleSection": post.category,
  "inLanguage": "en-IN",
  "url": `https://qshala.vercel.app/blog/${post.slug}`,
  "datePublished": post.isoDate,
  "dateModified": "2026-10-14T18:00:00+05:30",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://qshala.vercel.app/blog/${post.slug}`
  },
  "author": {
    "@type": "Person",
    "name": post.author,
    "jobTitle": post.authorRole,
    "worksFor": {
      "@id": "https://qshala.vercel.app/#organization"
    }
  },
  "publisher": {
    "@id": "https://qshala.vercel.app/#organization"
  },
  "isPartOf": {
    "@id": "https://qshala.vercel.app/#website"
  },
  "image": "https://qshala.vercel.app/og-image.webp"
};
---

<BaseLayout 
  title={`${post.title} | QShala Blog`}
  description={post.summary}
  ogType="article"
  articleMeta={{
    author: post.author,
    section: post.category,
    tags: [post.category, "Quriosity", "Education", "QShala"]
  }}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Blog", item: "/blog" },
    { name: post.title, item: `/blog/${post.slug}` }
  ]}
  schema={articleSchema}
>
  <Navbar />
  <main id="main-content" class="flex-grow pt-32 pb-24 px-6 bg-[#FFFDF5]">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-8 space-y-10">
        <!-- Back Button -->
        <div>
          <a href="/blog" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-slate-900 border border-slate-200 shadow-xs hover:-translate-y-0.5 hover:shadow-sm transition-all font-black uppercase text-xs font-heading">
            &larr; Back to Blog
          </a>
        </div>

        <!-- Article Header -->
        <div class="space-y-4 border-b border-slate-200 pb-8">
          <div class="flex flex-wrap items-center gap-3">
            <!-- Strictly two labels: Blog or Events -->
            <span class={`px-3.5 py-1 rounded-full font-black text-xs font-heading uppercase ${post.category === 'Events' ? 'bg-[#FDB913] text-slate-950' : 'bg-[#30B2E7] text-white'}`}>
              {post.category}
            </span>
            <span class="text-xs font-bold text-slate-500 font-heading">{post.date}</span>
            <span class="text-xs font-bold text-slate-500 font-heading">&bull; {post.readTime}</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black font-heading text-slate-900 leading-tight">
            {post.title}
          </h1>
        </div>

        <!-- Article Body -->
        <div class="prose prose-lg max-w-none text-slate-800 font-sans leading-relaxed" set:html={post.content} />

        <!-- Optional Image / Gallery Section (Shows only if images are provided) -->
        {post.gallery && post.gallery.length > 0 && (
          <section class="mt-12 pt-8 border-t border-slate-200 space-y-6">
            <div class="space-y-1">
              <span class="inline-block px-3 py-1 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase font-heading">
                Event Gallery ({post.gallery.length} Photos)
              </span>
              <h2 class="text-2xl sm:text-3xl font-black font-heading text-slate-900">
                Event Photos &amp; Highlights
              </h2>
              <p class="text-slate-600 text-sm font-semibold">
                High-resolution event photographs. Participants and attendees can view and access their photos below.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              {post.gallery.map((photo) => (
                <div class="group relative rounded-2xl overflow-hidden shadow-xs border border-slate-200/80 bg-slate-100 aspect-[4/3]">
                  <img 
                    src={photo.url} 
                    alt={photo.caption} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                    loading="lazy"
                  />
                  {photo.caption && (
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-3 flex items-end">
                      <p class="text-white text-xs font-semibold leading-snug">{photo.caption}</p>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Footer CTA Box -->
        <div class="bg-[#FFF8E1] rounded-3xl p-8 border border-amber-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6 mt-12">
          <div class="space-y-1 text-center sm:text-left">
            <h3 class="text-xl font-black font-heading text-slate-900">Enjoyed this perspective?</h3>
            <p class="text-slate-700 text-xs font-semibold">Book a live socratic quiz session for your school or organization.</p>
          </div>
          <a href="/contact" class="px-6 py-3 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs uppercase font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all whitespace-nowrap">
            Schedule an Experience &rarr;
          </a>
        </div>
      </div>

      <!-- Right Sidebar (Mascot & Widget) -->
      <div class="hidden lg:flex lg:col-span-4 flex-col items-center justify-start pt-4 sticky top-32 space-y-10">
        <div class="transform hover:scale-105 transition-transform duration-300">
          <QTMascot client:visible variant="reading" size="xl" badgeText="Quiet Time!" />
        </div>
        
        <!-- Mini Newsletter Widget -->
        <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-sm text-center w-full max-w-sm">
