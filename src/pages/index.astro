---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TypewriterHeadline from '../components/TypewriterHeadline';
import DailyQuizSection from '../components/DailyQuizSection';
import QTMascot from '../components/QTMascot';
import ClientMarquee from '../components/ClientMarquee.astro';
import QShalaEffectTabs from '../components/QShalaEffectTabs';
import InteractiveCaseStudiesShowcase from '../components/InteractiveCaseStudiesShowcase';
import AnimatedHeroMascotStage from '../components/AnimatedHeroMascotStage';
import FAQSection from '../components/FAQSection';
import TestimonialsMarquee from '../components/TestimonialsMarquee.astro';
import UpcomingEventsSlider from '../components/UpcomingEventsSlider';
import { CASE_STUDIES_DATA } from '../lib/data';

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://qshala.vercel.app/#faq",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What makes QShala different from traditional quiz competitions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Traditional quizzes test memorization of static facts. QShala focuses on Socratic storytelling, critical thinking, and 'Why?' questions. We turn learning into an active discovery quest rather than a memory test."
      }
    },
    {
      "@type": "Question",
      "name": "Are QShala sessions conducted online or in-person?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both! We host live in-person workshops, auditoriums, and stage championships, as well as hybrid and fully remote sessions with digital buzzers and real-time leaderboards."
      }
    },
    {
      "@type": "Question",
      "name": "How do QShala Quriosity Clubs fit into a school timetable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "QShala Quriosity Clubs are designed as 40 to 60-minute weekly modules that easily replace or complement standard General Knowledge, Library, or Life Skills periods for Grades 1 through 12."
      }
    },
    {
      "@type": "Question",
      "name": "What age groups are QShala programs designed for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We have age-tailored programs for Primary (Grades 1-4: Quriosity Builders), Middle School (Grades 5-8: Quriosity Explorers), and High School (Grades 9-12: Quriosity Thinkers)."
      }
    },
    {
      "@type": "Question",
      "name": "How do QShala corporate trivia sessions help reduce attrition?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Shared play builds psychological safety and cross-team camaraderie. Our corporate sessions create low-pressure, high-fun environments where colleagues connect beyond daily work tasks."
      }
    },
    {
      "@type": "Question",
      "name": "Can QShala customize trivia around our company history and products?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! We frequently design custom brand trivia, company milestone quizzes, and onboarding challenges tailored specifically to your corporate culture."
      }
    }
  ]
};
---

<BaseLayout 
  title="QShala | Questions • Quriosity • Quests — India's Quriosity Company"
  description="Replacing rote learning with quriosity, socratic storytelling, and inquiry-led thinking. Partnering with 250+ K-12 schools and 80+ top corporates across India."
  schema={faqSchema}
>
  <Navbar />

  <main id="main-content" class="flex-grow overflow-x-hidden">
    
    <!-- 1. HERO (Banner) -->
    <section id="hero" class="relative pt-28 pb-16 md:pt-32 md:pb-20 bg-[#FFFDF5]">
      
      <!-- Ambient Glowing Orbs -->
      <div class="absolute top-10 left-1/4 w-96 h-96 bg-[#30B2E7]/15 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
      <div class="absolute top-40 right-1/4 w-[28rem] h-[28rem] bg-[#FDB913]/20 rounded-full blur-3xl pointer-events-none animate-pulse" style={{ animationDelay: '1s' }}></div>

      <div class="max-w-7xl mx-auto px-6 relative z-10">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <!-- Left Content -->
          <div class="lg:col-span-7 space-y-6 text-left">
            <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white border border-slate-200 shadow-sm">
              <span class="w-2.5 h-2.5 rounded-full bg-[#30B2E7] animate-ping"></span>
              <span class="text-xs font-black uppercase text-slate-800 tracking-wider font-heading">
                India&apos;s Quriosity Platform
              </span>
            </div>

            <div class="text-left">
              <TypewriterHeadline client:idle />
            </div>

            <div class="pt-4 flex flex-wrap items-center gap-4">
              <a
                href="/book-a-quiz"
                class="px-8 py-4 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-base shadow-md hover:-translate-y-0.5 transition-all flex items-center gap-2 font-heading"
              >
                Book a Quriosity Experience →
              </a>
            </div>
          </div>

          <!-- Right Interactive Stage (Trivia Generator) -->
          <div class="lg:col-span-5 flex justify-center w-full">
            <AnimatedHeroMascotStage client:visible />
          </div>

        </div>

      </div>
    </section>

    <!-- 2. UPCOMING EVENTS -->
    <section id="events" class="py-20 bg-[#E8F6FD] border-t border-b border-sky-100">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-10 flex flex-col items-center">
          <div class="inline-flex items-center justify-center gap-4 mb-3">
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 font-heading">Upcoming Events</h2>
            <div class="shrink-0">
               <QTMascot client:visible variant="happy" size="md" />
            </div>
          </div>
          <p class="text-slate-600 font-semibold">Join us for live quizzes, offline tournaments, and community events.</p>
        </div>
        
        <UpcomingEventsSlider client:load />
      </div>
    </section>

    <!-- 3. TRUSTED BY THE BEST -->
    <section id="partners" class="py-16 bg-white">
      <ClientMarquee />
    </section>

    <!-- 4. EXPLORE THE QSHALA EFFECT -->
    <section id="effect" class="relative overflow-hidden">
      <QShalaEffectTabs client:visible />
    </section>

    <!-- 5. GAME (Daily Quiz Playground with Dynamic Rotation) -->
    <section id="game" class="py-16 md:py-24 bg-[#FFFDF5]">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-xl mx-auto mb-12">
          <span class="px-4 py-1.5 rounded-full bg-[#75B543]/15 text-[#75B543] font-black text-xs uppercase font-heading">
            Daily Game
          </span>
          <h3 class="text-4xl font-black text-slate-900 mt-4 font-heading">Test Your Quriosity</h3>
          <p class="text-sm font-semibold text-slate-600 mt-2">Pick an answer below to trigger a celebration!</p>
        </div>

        <DailyQuizSection client:load />
      </div>
    </section>

    <!-- 6. NEWSLETTER / QSHOTS -->
    <section id="newsletter" class="pt-16 pb-12 md:pt-20 md:pb-16 bg-[#F2FCE8] relative overflow-hidden border-t border-[#75B543]/20">
      <div class="max-w-7xl mx-auto px-6 flex flex-col lg:flex-row items-center justify-between gap-12 relative z-10">
        
        <!-- Left Content (Newsletter badge removed, weekly changed to Daily) -->
        <div class="text-center lg:text-left space-y-3 max-w-xl">
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
            Subscribe to QShots.
          </h2>
          <p class="text-slate-700 text-base md:text-lg font-semibold">
            Get Daily trivia bites straight to your inbox. No spam, just pure curiosity.
          </p>
        </div>
        
        <!-- Right Form & Mascot -->
        <div class="w-full lg:w-1/2 flex flex-col sm:flex-row items-center justify-center lg:justify-end gap-6">
          <form class="flex w-full max-w-md flex-col sm:flex-row gap-2 relative z-10" onsubmit="event.preventDefault();">
            <input 
              type="email" 
              id="qshots-email"
              name="email"
              aria-label="Email address for QShots daily trivia"
              placeholder="Enter your email address" 
              class="flex-grow px-6 py-4 rounded-full bg-white border border-slate-200 text-sm font-medium focus:outline-none focus:border-[#75B543] focus:ring-4 focus:ring-[#75B543]/10 shadow-sm transition-all"
              required
            />
            <button 
              type="submit" 
              class="px-8 py-4 rounded-full bg-slate-900 text-white font-black text-xs uppercase font-heading hover:bg-[#75B543] transition-colors whitespace-nowrap shadow-md hover:shadow-lg hover:-translate-y-0.5"
            >
              Subscribe &rarr;
            </button>
          </form>

          <!-- Mascot -->
          <div class="hidden sm:block shrink-0 transform hover:scale-110 hover:-rotate-6 transition-transform duration-300">
             <QTMascot client:visible variant="happy" size="md" />
          </div>
        </div>

      </div>

      <!-- Downward Continuation Flow Cue (Clarifying content continues below) -->
      <div class="mt-8 flex justify-center items-center gap-2 text-slate-500 text-xs font-black uppercase tracking-wider font-heading">
        <span>Scroll to explore real stories &amp; impact</span>
        <svg class="w-4 h-4 animate-bounce text-[#75B543]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </section>

    <!-- 7. CASE STUDIES -->
    <section id="case-studies" class="py-16 md:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6 space-y-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between">
          <div>
            <span class="px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase tracking-wider font-heading">
              Real Impact Stories
            </span>
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight mt-4 font-heading">
              10+ Storytelling Case Studies.
            </h2>
          </div>
          <a href="/case-studies" class="mt-4 md:mt-0 px-6 py-3 rounded-full bg-[#30B2E7] hover:bg-sky-500 text-white font-black text-xs border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] font-heading transition-all inline-block">
            Explore All 10 Case Studies →
          </a>
        </div>

        <InteractiveCaseStudiesShowcase caseStudies={CASE_STUDIES_DATA} client:visible />
      </div>
    </section>

    <!-- 8. WALL OF LOVE -->
    <div class="bg-[#FFFDF5] pt-12 pb-24">
      <TestimonialsMarquee />
    </div>

    <!-- 9. FREQUENTLY ASKED QUESTIONS -->
    <section id="faq" class="pt-12 pb-8 md:pt-16 md:pb-12 bg-[#FFFDF5] relative">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-10 space-y-3">
          <span class="px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase tracking-wider font-heading">
            How can we help?
          </span>
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 font-heading">Frequently Asked Questions</h2>
        </div>
        <FAQSection client:load />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
