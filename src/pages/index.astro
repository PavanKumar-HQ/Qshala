---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TypewriterHeadline from '../components/TypewriterHeadline';
import InteractiveQuizCard from '../components/InteractiveQuizCard';
import QTMascot from '../components/QTMascot';
import ClientMarquee from '../components/ClientMarquee.astro';
import QShalaEffectTabs from '../components/QShalaEffectTabs';
import CuriosityRecommendationWidget from '../components/CuriosityRecommendationWidget';
import FAQSection from '../components/FAQSection';
import { FEATURED_QUIZZES, CASE_STUDIES_DATA, PRODUCTS_DATA } from '../lib/data';
---

<BaseLayout title="QShala | Questions • Quriosity • Quests — India's Curiosity Company">
  <Navbar />

  <main class="flex-grow overflow-x-hidden">
    
    <!-- ==================================================================== -->
    <!-- SECTION 01 // HERO & DAILY QUIZ PLAYGROUND                           -->
    <!-- ==================================================================== -->
    <section id="hero" class="relative pt-36 pb-24 md:pt-44 md:pb-28 bg-[#FFFDF5] border-b border-black/10">
      
      <!-- Ambient Glowing Orbs -->
      <div class="absolute top-10 left-1/4 w-96 h-96 bg-[#30B2E7]/15 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
      <div class="absolute top-40 right-1/4 w-[28rem] h-[28rem] bg-[#FDB913]/20 rounded-full blur-3xl pointer-events-none animate-pulse" style={{ animationDelay: '1s' }}></div>

      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="text-center max-w-4xl mx-auto space-y-6">
          
          <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white border border-black/10 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-[#30B2E7] animate-ping"></span>
            <span class="text-xs font-black uppercase text-slate-800 tracking-wider font-heading">
              SECTION 01 // INDIA'S CURIOSITY PLATFORM
            </span>
          </div>

          <!-- Typewriter Headline Island -->
          <TypewriterHeadline client:idle />

          <p class="text-lg sm:text-xl font-semibold text-slate-700 max-w-2xl mx-auto leading-relaxed pt-2">
            QShala replaces rote memorization with socratic storytelling, interactive trivia, and weekly curiosity clubs that empower minds to ask <span class="text-[#75B543] font-black underline decoration-[#75B543]/40 decoration-4">&ldquo;Why?&rdquo;</span>
          </p>

          <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
            <a
              href="/book-a-quiz"
              class="px-8 py-4 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-base border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-0.5 transition-all flex items-center gap-2 font-heading"
            >
              Book a Curiosity Experience →
            </a>

            <a
              href="/about"
              class="px-8 py-4 rounded-full bg-white hover:bg-slate-50 text-slate-900 font-black text-base border border-slate-200 shadow-sm hover:border-black transition-all font-heading"
            >
              Explore Our Mission
            </a>
          </div>

          <!-- Trust Bar -->
          <div class="pt-8 flex flex-wrap items-center justify-center gap-8 text-slate-600 text-sm font-bold">
            <div class="flex items-center gap-2">
              <span class="text-[#FDB913] text-base">★★★★★</span>
              <span>4.9/5 Rating</span>
            </div>
            <span class="text-slate-300">•</span>
            <div><strong class="text-slate-900 font-heading text-base">400,000+</strong> Learners Engaged</div>
            <span class="text-slate-300">•</span>
            <div><strong class="text-slate-900 font-heading text-base">250+</strong> Partner Schools</div>
          </div>
        </div>

        <!-- Mascot Spotlight -->
        <div class="mt-14 flex justify-center">
          <QTMascot client:visible variant="quizzing" size="xl" badgeText="Curiosity Champion!" />
        </div>

        <!-- Daily Quiz Playground Sub-block -->
        <div class="mt-20 pt-12 border-t border-black/10">
          <div class="text-center max-w-xl mx-auto mb-10">
            <span class="px-4 py-1 rounded-full bg-[#75B543]/15 text-[#75B543] font-black text-xs uppercase font-heading">
              Interactive Quiz Playground
            </span>
            <h3 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2 font-heading">Test Your Curiosity</h3>
            <p class="text-xs font-semibold text-slate-600 mt-1">Pick an answer below to trigger celebration!</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
            {FEATURED_QUIZZES.map((quiz) => (
              <InteractiveQuizCard client:load quiz={quiz} />
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- ==================================================================== -->
    <!-- SECTION 02 // TRUSTED CLIENTS & PARTNERS MARQUEE                     -->
    <!-- ==================================================================== -->
    <section id="partners" class="py-12 bg-white border-b border-black/10">
      <div class="max-w-7xl mx-auto px-6 mb-6 text-center">
        <span class="text-[11px] font-black uppercase text-slate-400 tracking-widest font-heading">
          SECTION 02 // TRUSTED BY 100+ CORPORATES &amp; 250+ INSTITUTIONS
        </span>
      </div>
      <ClientMarquee />
    </section>

    <!-- ==================================================================== -->
    <!-- SECTION 03 // SOLUTIONS & PROGRAM FORMATS                             -->
    <!-- ==================================================================== -->
    <section id="solutions" class="py-24 bg-[#E8F6FD]/40 border-b border-black/10 relative">
      <div class="max-w-7xl mx-auto px-6 space-y-20">
        
        <div class="text-center max-w-3xl mx-auto space-y-3">
          <span class="px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
            SECTION 03 // CURIOSITY FORMATS
          </span>
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
            Designed for Schools, Corporates &amp; Communities.
          </h2>
          <p class="text-slate-600 text-base font-semibold max-w-xl mx-auto">
            Custom curiosity solutions engineered for K-12 classrooms and corporate teams.
          </p>
        </div>

        <!-- Schools Feature Row -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-white p-8 md:p-12 rounded-3xl border border-black/10 shadow-sm">
          <div class="lg:col-span-7 space-y-6">
            <span class="px-3.5 py-1.5 rounded-full bg-[#E8F6FD] text-[#30B2E7] font-black text-xs uppercase font-heading">
              For K-12 Educational Institutions
            </span>
            <h3 class="text-3xl md:text-4xl font-black text-slate-900 font-heading leading-tight">
              Transforming Classrooms into Hubs of Active Questioning.
            </h3>
            <p class="text-slate-700 text-base leading-relaxed font-semibold">
              QShala for Schools replaces static textbook learning with structured weekly curiosity clubs, current affairs storytelling, and socratic debate. Over 250+ leading schools across India use QShala to foster 21st-century skills.
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div class="p-4 rounded-2xl bg-[#FFFDF5] border border-slate-200 space-y-1">
                <div class="font-black text-slate-900 text-sm font-heading">Weekly Curiosity Clubs</div>
                <div class="text-xs text-slate-600 font-medium">Integrated directly into weekly timetables for Grades 1–12.</div>
              </div>
              <div class="p-4 rounded-2xl bg-[#FFFDF5] border border-slate-200 space-y-1">
                <div class="font-black text-slate-900 text-sm font-heading">Current Affairs Storytelling</div>
                <div class="text-xs text-slate-600 font-medium">Decoding global science, civics, and history into engaging stories.</div>
              </div>
            </div>

            <div class="pt-2">
              <a href="/schools" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-[#30B2E7] text-white font-black text-sm hover:bg-sky-500 transition-all font-heading shadow-md">
                Explore School Programs →
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 flex justify-center">
            <div class="relative p-8 rounded-3xl bg-[#E8F6FD] border border-[#30B2E7]/30 w-full flex flex-col items-center text-center space-y-6">
              <QTMascot client:visible variant="reading" size="lg" badgeText="Study Squad!" />
              <div class="space-y-1">
                <div class="text-3xl font-black text-slate-900 font-heading">250+ Schools</div>
                <div class="text-xs font-bold text-slate-600">DPS, National Public School, Inventure &amp; more</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Corporates Feature Row -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center bg-white p-8 md:p-12 rounded-3xl border border-black/10 shadow-sm">
          <div class="lg:col-span-5 order-2 lg:order-1 flex justify-center">
            <div class="relative p-8 rounded-3xl bg-[#FFF8E1] border border-[#FDB913]/30 w-full flex flex-col items-center text-center space-y-6">
              <QTMascot client:visible variant="professional" size="lg" badgeText="Team Spirit!" />
              <div class="space-y-1">
                <div class="text-3xl font-black text-slate-900 font-heading">10% Lower Attrition</div>
                <div class="text-xs font-bold text-slate-600">Proven bonding impact across 100+ corporate clients</div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 order-1 lg:order-2 space-y-6">
            <span class="px-3.5 py-1.5 rounded-full bg-[#FFF8E1] text-amber-600 font-black text-xs uppercase font-heading">
              For Corporate L&amp;D &amp; HR Leaders
            </span>
            <h3 class="text-3xl md:text-4xl font-black text-slate-900 font-heading leading-tight">
              High-Octane Team Bonding &amp; Leadership Offsites.
            </h3>
            <p class="text-slate-700 text-base leading-relaxed font-semibold">
              Bring remote and hybrid teams together with interactive trivia leagues, brand story championships, and socratic leadership workshops that reduce employee attrition and build authentic camaraderie.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div class="p-4 rounded-2xl bg-[#FFFDF5] border border-slate-200 space-y-1">
                <div class="font-black text-slate-900 text-sm font-heading">Culture Circles &amp; Calendars</div>
                <div class="text-xs text-slate-600 font-medium">Year-round employee engagement and friendly team competitions.</div>
              </div>
              <div class="p-4 rounded-2xl bg-[#FFFDF5] border border-slate-200 space-y-1">
                <div class="font-black text-slate-900 text-sm font-heading">Custom Brand Trivia</div>
                <div class="text-xs text-slate-600 font-medium">Gamifying company history, product knowledge, and onboarding.</div>
              </div>
            </div>

            <div class="pt-2">
              <a href="/companies" class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-sm transition-all font-heading shadow-md">
                Corporate Offsites →
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ==================================================================== -->
    <!-- SECTION 04 // THE QSHALA EFFECT (MEASURED IMPACT TABS)               -->
    <!-- ==================================================================== -->
    <section id="effect" class="py-24 bg-[#FFF8E1]/30 border-b border-black/10 relative">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-14 space-y-2">
          <span class="px-4 py-1.5 rounded-full bg-[#FDB913] text-black font-black text-xs uppercase tracking-wider font-heading shadow-sm">
            SECTION 04 // MEASURED IMPACT
          </span>
          <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight font-heading">
            Explore the QShala Effect.
          </h2>
        </div>
        <QShalaEffectTabs client:visible />
      </div>
    </section>

    <!-- ==================================================================== -->
    <!-- SECTION 05 // INTERACTIVE PROGRAM FINDER                             -->
    <!-- ==================================================================== -->
    <section id="finder" class="py-24 bg-white border-b border-black/10 relative">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-10">
          <span class="px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
            SECTION 05 // PROGRAM FINDER
          </span>
        </div>
        <CuriosityRecommendationWidget client:visible />
      </div>
    </section>

    <!-- ==================================================================== -->
    <!-- SECTION 06 // REAL-WORLD CASE STUDIES                                -->
    <!-- ==================================================================== -->
    <section id="case-studies" class="py-24 bg-[#FFFDF5] border-b border-black/10 relative">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-14">
          <div>
            <span class="px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
              SECTION 06 // REAL IMPACT STORIES
            </span>
            <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight mt-3 font-heading">
              Storytelling Case Studies.
            </h2>
          </div>
          <a href="/case-studies" class="mt-4 md:mt-0 text-sm font-black text-[#30B2E7] hover:underline font-heading">
            View All Case Studies →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {CASE_STUDIES_DATA.map((cs, idx) => (
            <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm relative overflow-hidden group hover:border-black transition-all">
              <div class="absolute top-6 right-6 z-10">
                <QTMascot client:visible variant={idx === 0 ? "sherlock" : "quizzing"} size="sm" />
              </div>
              <span class="px-3 py-1 rounded-full bg-slate-900 text-white font-black text-[10px] uppercase font-heading">{cs.clientType} • {cs.clientName}</span>
              <h3 class="text-2xl font-black text-slate-900 mt-4 mb-3 leading-snug font-heading pr-12">{cs.title}</h3>
              <p class="text-slate-700 text-sm leading-relaxed mb-6 font-semibold">{cs.summary}</p>
              
              <div class="grid grid-cols-3 gap-4 p-4 rounded-2xl bg-[#30B2E7]/10 border border-[#30B2E7]/20 mb-6">
                {cs.impactMetrics.map((m) => (
                  <div class="text-center">
                    <div class="text-xl font-black text-[#30B2E7] font-heading">{m.value}</div>
                    <div class="text-[10px] font-black uppercase text-slate-700">{m.label}</div>
                  </div>
                ))}
              </div>

              <blockquote class="border-l-4 border-[#FDB913] pl-4 text-xs italic text-slate-800 font-semibold py-1">
                &ldquo;{cs.quote.text}&rdquo;
                <footer class="text-slate-600 font-black not-italic mt-1">— {cs.quote.author}, {cs.quote.role}</footer>
              </blockquote>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ==================================================================== -->
    <!-- SECTION 07 // CURIOSITY STORE                                         -->
    <!-- ==================================================================== -->
    <section id="store" class="py-24 bg-white border-b border-black/10 relative">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-2">
          <span class="px-4 py-1.5 rounded-full bg-[#FDB913] text-black font-black text-xs uppercase tracking-wider font-heading shadow-sm">
            SECTION 07 // CURIOSITY STORE
          </span>
          <h2 class="text-4xl font-black text-slate-900 font-heading">Interactive Games, Books &amp; Kits</h2>
          <p class="text-slate-600 text-sm font-semibold">Handcrafted learning decks and journals to bring curiosity home.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {PRODUCTS_DATA.map((product, pIdx) => {
            const productMascots = ["idea", "reading", "holding_money", "trophy"] as const;
            return (
              <div class="bg-[#FFFDF5] rounded-3xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between group relative overflow-hidden hover:border-black transition-all">
                <div class="absolute top-2 right-2 z-10 scale-75 origin-top-right">
                  <QTMascot client:visible variant={productMascots[pIdx % productMascots.length]} size="sm" />
                </div>
                <div>
                  <div class={`h-40 rounded-2xl ${product.imageColor} flex items-center justify-center text-white font-black text-xl p-4 shadow-inner mb-4 relative`}>
                    {product.isPopular && (
                      <span class="absolute top-2 left-2 px-2.5 py-1 bg-black text-white font-black text-[10px] rounded-full border border-white">BESTSELLER</span>
                    )}
                    <span class="font-mikado">{product.title.split(' ')[0]}</span>
                  </div>
                  <span class="text-[10px] font-black uppercase text-[#30B2E7]">{product.category}</span>
                  <h3 class="text-lg font-black text-slate-900 mt-1 font-heading line-clamp-1">{product.title}</h3>
                  <p class="text-slate-600 text-xs mt-1 font-medium line-clamp-2">{product.description}</p>
                </div>
                <div class="mt-4 pt-4 border-t border-slate-200 flex items-center justify-between">
                  <span class="text-lg font-black text-slate-900 font-heading">{product.price}</span>
                  <a href="/shop" class="px-4 py-2 rounded-full bg-[#30B2E7] text-white font-black text-xs font-heading hover:bg-sky-500 transition-colors">
                    View Details
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ==================================================================== -->
    <!-- SECTION 08 // FAQ ACCORDION                                           -->
    <!-- ==================================================================== -->
    <section id="faq" class="py-24 bg-[#FFFDF5] relative">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-14 space-y-2">
          <span class="px-4 py-1.5 rounded-full bg-[#75B543] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
            SECTION 08 // FREQUENTLY ASKED QUESTIONS
          </span>
          <h2 class="text-4xl font-black text-slate-900 font-heading">Need Clarification?</h2>
          <p class="text-slate-600 text-sm font-semibold">Everything you need to know about QShala sessions and methodology.</p>
        </div>
        <FAQSection client:visible />
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
