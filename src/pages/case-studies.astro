---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import InteractiveCaseStudiesShowcase from '../components/InteractiveCaseStudiesShowcase';
import { CASE_STUDIES_DATA } from '../lib/data';
---

<BaseLayout 
  title="Case Studies & Learning Impact | QShala India"
  description="Real-world case studies detailing how 10+ schools, corporates, and universities partnered with QShala to foster curiosity and critical thinking."
  pageType="CollectionPage"
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Case Studies", item: "/case-studies" }
  ]}
>
  <Navbar />
  <main id="main-content" class="flex-grow pt-36 pb-24 px-6 bg-[#FFFDF5]">
    <div class="max-w-7xl mx-auto space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase border border-black font-heading shadow-sm">
          Measurable Results &amp; Impact
        </span>
        <h1 class="text-4xl sm:text-6xl font-black text-slate-900 font-heading">QShala Case Studies</h1>
        <p class="text-slate-600 text-base font-semibold max-w-xl mx-auto">
          Explore how 10+ leading schools, corporates, universities, and communities use QShala to spark quriosity and engagement.
        </p>
      </div>

      <InteractiveCaseStudiesShowcase caseStudies={CASE_STUDIES_DATA} client:load />
    </div>
  </main>
  <Footer />
</BaseLayout>
