---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QTMascot from '../components/QTMascot';

const YEAR_LONG_PROGRAMS = [
  {
    title: "1. Weekly Quriosity Clubs",
    badge: "Grades 1 - 12",
    tagline: "Timetabled Socratic Questioning & Thinking Sport",
    description: "Weekly 45-minute inquiry-driven sessions built directly into the school timetable. Students explore the 'Why?' behind science, history, space, nature, and human inventions through interactive challenges.",
    outcomes: ["Moves beyond rote memorization", "Fosters intrinsic motivation to learn", "Encourages creative problem solving"],
    accent: "#30B2E7",
    bg: "bg-[#E8F6FD]"
  },
  {
    title: "2. Financial Literacy Program",
    badge: "Grades 4 - 12",
    tagline: "Money Mindsets, Smart Saving & Junior Economics",
    description: "Gamified financial literacy curriculum covering budgeting, banking fundamentals, needs vs. wants, inflation, compound interest, entrepreneurship, and digital money safety through real-world simulations.",
    outcomes: ["Practical money management habits", "Understanding economic concepts early", "Entrepreneurial thinking"],
    accent: "#75B543",
    bg: "bg-[#EDF7E5]"
  },
  {
    title: "3. Public Speaking & Socratic Debate",
    badge: "Grades 5 - 12",
    tagline: "Confident Articulation, Logic & Persuasion",
    description: "Interactive verbal expression labs where students learn to structure thoughts, analyze logical fallacies, deliver persuasive arguments, and speak on their feet without stage fright.",
    outcomes: ["Overcoming stage anxiety", "Constructing evidence-based arguments", "Active listening and civil debate"],
    accent: "#FDB913",
    bg: "bg-[#FFF8E1]"
  },
  {
    title: "4. GK & Current Affairs Storytelling",
    badge: "Grades 3 - 12",
    tagline: "Connecting Headlines to Context & Global Awareness",
    description: "Transforming dry current affairs into gripping investigative stories. We decode global geopolitics, climate science, tech innovations, and cultural milestones into bite-sized discovery quests.",
    outcomes: ["Global citizenship and awareness", "Media literacy & fact-checking skills", "Connecting textbooks to current news"],
    accent: "#9333EA",
    bg: "bg-[#F3E8FF]"
  }
];

const schoolServiceSchema = {
  "@type": "Service",
  "@id": "https://qshala.vercel.app/schools#service",
  "name": "QShala for Schools & K-12",
  "serviceType": "K-12 Educational Curriculum & Year-Long Quriosity Programs",
  "description": "Year-long timetabled programs for K-12 schools including Quiz Clubs, Financial Literacy, Public Speaking, and General Knowledge storytelling.",
  "provider": {
    "@id": "https://qshala.vercel.app/#organization"
  }
};
---

<BaseLayout 
  title="QShala for Schools & K-12 | Year-Long Programs & Quiz Clubs"
  description="Year-long school programs: Quiz Clubs, Financial Literacy, Public Speaking, and GK Storytelling across 250+ K-12 partner schools in India."
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Services", item: "/services" },
    { name: "For Schools", item: "/schools" }
  ]}
  schema={schoolServiceSchema}
>
  <Navbar />
  
  <main id="main-content" class="flex-grow pt-28 pb-24 px-4 sm:px-8 max-w-7xl mx-auto space-y-16 bg-[#FFFDF5]">
    
    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto space-y-4 pt-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#30B2E7] text-white font-black text-xs uppercase tracking-wider font-heading shadow-sm">
        K-12 Educational Partnerships
      </span>
      <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight font-heading leading-tight">
        Year-Long Programs for Forward-Thinking Schools.
      </h1>
      <p class="text-slate-600 font-semibold text-base sm:text-lg leading-relaxed">
        We partner with 250+ K-12 schools to integrate structured, year-long learning tracks into the academic timetable. No rote drill worksheets—only active, wonder-led discovery.
      </p>
    </div>

    <!-- Mascot Banner -->
    <div class="flex justify-center">
      <QTMascot client:visible variant="reading" size="lg" badgeText="250+ Partner Schools" />
    </div>

    <!-- Year-Long Programs Grid -->
    <div class="space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading">
          Our Core Year-Long School Programs
        </h2>
        <p class="text-slate-600 text-sm font-semibold">
          Designed for standard 40 to 60-minute weekly timetable periods across Primary, Middle, and High School.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {YEAR_LONG_PROGRAMS.map((prog) => (
          <div class={`rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-md transition-all ${prog.bg} flex flex-col justify-between space-y-6`}>
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-3">
                <span 
                  class="px-3 py-1 rounded-full text-white text-xs font-black uppercase font-heading shadow-sm"
                  style={`background-color: ${prog.accent};`}
                >
                  {prog.badge}
                </span>
              </div>

              <div>
                <h3 class="text-2xl font-black text-slate-900 font-heading leading-snug">
                  {prog.title}
                </h3>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-600 font-heading mt-1">
                  {prog.tagline}
                </p>
              </div>

              <p class="text-slate-700 text-sm font-semibold leading-relaxed">
                {prog.description}
              </p>

              <div class="space-y-2 pt-2 border-t border-black/5">
                <span class="text-xs font-black uppercase tracking-wider text-slate-500 font-heading">Key Learning Outcomes:</span>
                <ul class="space-y-1.5">
                  {prog.outcomes.map((outcome) => (
                    <li class="text-xs font-bold text-slate-800 flex items-center gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-slate-900 shrink-0"></span>
                      <span>{outcome}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Inter-School Quiz Championships & Events Banner -->
    <div class="bg-white rounded-3xl p-8 md:p-10 border border-slate-200/80 shadow-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-8 space-y-3">
        <span class="px-3 py-1 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase font-heading">
          State &amp; National Events
        </span>
        <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-heading">
          Inter-School Quiz Championships &amp; Science Bees
        </h3>
        <p class="text-slate-700 text-sm font-semibold leading-relaxed">
          Beyond our weekly curriculum, we produce India's most celebrated school quiz tournaments with stage buzzers, digital scoreboards, and charismatic quizmasters.
        </p>
      </div>
      <div class="lg:col-span-4 flex justify-center lg:justify-end">
        <QTMascot client:visible variant="trophy" size="md" />
      </div>
    </div>

    <!-- DIRECT DEPARTMENT CONTACT & CONSULTATIVE SALES (No Form) -->
    <div class="bg-[#FFF8E1] rounded-3xl p-8 md:p-12 border border-amber-200/80 shadow-sm text-center max-w-4xl mx-auto space-y-8">
      <div class="space-y-3">
        <span class="px-4 py-1.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs uppercase font-heading shadow-sm">
          Consultative Partnerships
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 font-heading">
          Speak Directly with Our School Partnerships Team
        </h2>
        <p class="text-slate-700 font-semibold text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Because every school timetable and curriculum is unique, we work closely with Principals, Trustees, and Academic Coordinators. Connect with our dedicated school lead or call Co-Founder Sachin directly.
        </p>
      </div>

      <!-- Direct Contact Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto text-left">
        
        {/* School Partnerships Lead */}
        <div class="p-6 rounded-2xl bg-white border border-amber-100 shadow-sm space-y-3">
          <div class="text-xs font-black uppercase text-amber-600 font-heading">Department Lead</div>
          <div class="text-lg font-black text-slate-900 font-heading">School Partnerships Team</div>
          <div class="text-xs text-slate-600 font-semibold">Quriosity Clubs &amp; Year-Long Timetable Integration</div>
          <div class="pt-2 space-y-2">
            <a 
              href="mailto:qshala@walnuts.co.in?subject=School%20Partnership%20Inquiry" 
              class="inline-flex items-center gap-2 text-xs font-black text-[#30B2E7] hover:underline font-heading"
            >
              ✉ qshala@walnuts.co.in
            </a>
            <div>
              <a 
                href="tel:+918971676100" 
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#30B2E7] text-white font-black text-xs font-heading shadow-sm hover:bg-sky-500 transition-colors"
              >
                📞 Call School Team: +91 89716 76100
              </a>
            </div>
          </div>
        </div>

        {/* Sachin Ravi Direct */}
        <div class="p-6 rounded-2xl bg-white border border-amber-100 shadow-sm space-y-3">
          <div class="text-xs font-black uppercase text-amber-600 font-heading">Founder &amp; Chief Quizmaster</div>
          <div class="text-lg font-black text-slate-900 font-heading">Sachin Ravi</div>
          <div class="text-xs text-slate-600 font-semibold">Direct line for Principals, Trustees &amp; Keynotes</div>
          <div class="pt-2 space-y-2">
            <a 
              href="mailto:sachin@walnuts.co.in?subject=School%20Inquiry%20for%20Sachin" 
              class="inline-flex items-center gap-2 text-xs font-black text-amber-600 hover:underline font-heading"
            >
              ✉ sachin@walnuts.co.in
            </a>
            <div>
              <a 
                href="tel:+918971676100" 
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FDB913] text-slate-950 font-black text-xs font-heading shadow-sm hover:bg-amber-400 transition-colors"
              >
                📞 Call Sachin: +91 89716 76100
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Quick WhatsApp Action -->
      <div class="pt-2">
        <a 
          href="https://wa.me/918971676100?text=Hi%20QShala,%20we%20would%20like%20to%20discuss%20partnering%20for%20our%20school." 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-slate-950 font-black text-xs uppercase tracking-wider font-heading shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all"
        >
          <span>Chat on WhatsApp &rarr;</span>
        </a>
      </div>
    </div>

  </main>
  
  <Footer />
</BaseLayout>
