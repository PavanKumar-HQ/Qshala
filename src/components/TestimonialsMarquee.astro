    accent: "#30B2E7",
    bg: "#E8F6FD",
    initials: "RS"
  },
  {
    author: "Priya & Anand V.",
    role: "Parents of Grade 6 Learner",
    org: "Curiosity Club",
    type: "Parent",
    quote: "The Sunday Curiosity Club is the highlight of our child's week. Instead of screen scrolling, she discusses space at dinner!",
