    stars: 5,
    accent: "#30B2E7",
    bg: "#E8F6FD",
    initials: "SS"
  },
  {
    author: "Rajesh Nair",
    role: "Head of Employee Experience",
    org: "Flipkart",
    type: "Corporate",
    quote: "The energy QT and the QShala team brought to our townhalls was phenomenal. It bonded engineering and marketing seamlessly.",
    stars: 5,
    accent: "#FDB913",
    bg: "#FFF8E1",
    initials: "RN"
  },
  {
    author: "Manish Jain",
    role: "Global L&D Director",
    org: "Wipro",
