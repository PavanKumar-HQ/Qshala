---
// Pure static HTML Header component for maximum performance with active route highlighting
const pathname = Astro.url.pathname;

const NAV_LINKS = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about' },
  { name: 'Services', href: '/services' },
  { name: 'Case Studies', href: '/case-studies' },
  { name: 'Store', href: '/shop' },
  { name: 'Blog & Events', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];

const isLinkActive = (href: string) => {
  if (href === '/') return pathname === '/' || pathname === '';
  return pathname.startsWith(href);
};
---

<header 
  class="fixed top-0 left-0 right-0 z-50 transition-all bg-white/90 backdrop-blur-md border-b border-slate-200/60 shadow-xs"
  style="padding-top: env(safe-area-inset-top, 0px); padding-left: max(0.5rem, env(safe-area-inset-left, 0px)); padding-right: max(0.5rem, env(safe-area-inset-right, 0px));"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
    <!-- Official QShala SVG Logo -->
    <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="QShala Home">
      <img
        src="/assets/logos/QShala%20Logo%201.svg"
        alt="QShala Logo"
        width="140"
        height="36"
        class="h-8 sm:h-9 w-auto object-contain hover:scale-105 transition-transform duration-300"
        style="height: 36px; width: auto; max-width: 170px; display: block;"
        loading="eager"
      />
    </a>

    <!-- Desktop Nav Links with Active Route Highlighting & Left-to-Right Animated Underline -->
    <nav class="hidden lg:flex items-center gap-6 font-black text-slate-900 text-xs sm:text-sm font-heading">
      {NAV_LINKS.map((link) => {
        const active = isLinkActive(link.href);
        return (
          <a 
            href={link.href} 
            data-nav-href={link.href}
            data-astro-prefetch="hover" 
            class={`relative py-1 transition-colors ${
              active 
                ? 'text-[#30B2E7] after:w-full' 
                : 'hover:text-[#30B2E7] after:w-0 hover:after:w-full'
            } after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:bg-[#30B2E7] after:transition-all after:duration-300`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Action CTA -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href="/contact"
        data-astro-prefetch="hover"
        class="px-5 py-2.5 rounded-full bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black text-xs sm:text-sm shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all font-heading"
      >
        Get in Touch
      </a>
    </div>

    <!-- Mobile Hamburger SVG Icon Button -->
    <button
      id="menuToggleBtn"
      class="lg:hidden w-11 h-11 rounded-full bg-slate-100 text-slate-900 border border-slate-200 flex items-center justify-center cursor-pointer shadow-sm hover:bg-slate-200 active:scale-95 transition-all shrink-0"
      aria-label="Toggle Mobile Menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <svg class="w-5 h-5 fill-current text-slate-900" viewBox="0 0 24 24">
        <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Panel -->
  <div
    id="mobileMenu"
    class="hidden lg:hidden mt-2 mx-3 sm:mx-6 max-w-7xl bg-white rounded-3xl p-5 shadow-xl border border-slate-200 max-h-[calc(100dvh-5rem-env(safe-area-inset-top,0px))] overflow-y-auto"
  >
    <div class="flex flex-col gap-2 font-black text-slate-900 font-heading text-sm">
      {NAV_LINKS.map((link) => {
        const active = isLinkActive(link.href);
        return (
          <a
            href={link.href}
            data-nav-href={link.href}
            class={`px-4 py-2.5 rounded-2xl flex items-center justify-between transition-all ${
              active
                ? 'bg-[#30B2E7] text-white shadow-sm font-black'
                : 'text-slate-800 hover:bg-slate-50 font-bold'
            }`}
          >
            <span>{link.name}</span>
            <span class={`mobile-active-badge px-2.5 py-0.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-[10px] uppercase tracking-wider font-heading shadow-sm ${active ? '' : 'hidden'}`}>
              Active
            </span>
          </a>
        );
      })}

      <a
        href="/contact"
        class="mt-3 text-center py-3.5 rounded-2xl bg-[#FDB913] hover:bg-amber-400 text-slate-950 font-black shadow-sm uppercase tracking-wider text-xs font-heading"
      >
        Get in Touch &rarr;
      </a>
    </div>
  </div>
</header>

<script>
  function highlightActiveRoute() {
    const rawPath = window.location.pathname;
    const currentPath = rawPath.endsWith('/') && rawPath.length > 1 ? rawPath.slice(0, -1) : rawPath;

    // 1. Mobile Menu Highlighting
    const mobileLinks = document.querySelectorAll('#mobileMenu a[data-nav-href]');
    mobileLinks.forEach((link) => {
      const href = link.getAttribute('data-nav-href');
      const badge = link.querySelector('.mobile-active-badge');
      const isCurrent = href === '/' 
        ? (currentPath === '/' || currentPath === '') 
        : currentPath.startsWith(href || '');

      if (isCurrent) {
        link.className = "px-4 py-2.5 rounded-2xl flex items-center justify-between transition-all bg-[#30B2E7] text-white shadow-sm font-black";
        badge?.classList.remove('hidden');
      } else {
        link.className = "px-4 py-2.5 rounded-2xl flex items-center justify-between transition-all text-slate-800 hover:bg-slate-50 font-bold";
        badge?.classList.add('hidden');
      }
    });

    // 2. Desktop Nav Highlighting
    const desktopLinks = document.querySelectorAll('header nav a[data-nav-href]');
    desktopLinks.forEach((link) => {
      const href = link.getAttribute('data-nav-href');
      const isCurrent = href === '/' 
        ? (currentPath === '/' || currentPath === '') 
        : currentPath.startsWith(href || '');

      if (isCurrent) {
        link.classList.add('text-[#30B2E7]');
        link.classList.remove('text-slate-900');
      } else {
        link.classList.remove('text-[#30B2E7]');
        link.classList.add('text-slate-900');
      }
    });
  }

  function setupMenuToggle() {
    const menuToggleBtn = document.getElementById('menuToggleBtn');
    const mobileMenu = document.getElementById('mobileMenu');

    if (menuToggleBtn && mobileMenu) {
      menuToggleBtn.onclick = (e) => {
        e.stopPropagation();
        const isExpanded = menuToggleBtn.getAttribute('aria-expanded') === 'true';
        menuToggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
        mobileMenu.classList.toggle('hidden');
      };

      document.addEventListener('click', (e) => {
        if (!mobileMenu.contains(e.target as Node) && !menuToggleBtn.contains(e.target as Node)) {
          mobileMenu.classList.add('hidden');
          menuToggleBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  }

  highlightActiveRoute();
  setupMenuToggle();

  document.addEventListener('astro:page-load', () => {
    highlightActiveRoute();
    setupMenuToggle();
  });
</script>
