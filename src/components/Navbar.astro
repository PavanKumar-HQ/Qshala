---
// Pure static HTML Header component for maximum performance with active route highlighting
const pathname = Astro.url.pathname;

const NAV_LINKS = [
  { name: 'Home', href: '/' },
  { name: 'About Us', href: '/about' },
  { name: 'Services', href: '/services' },
  { name: 'Learn & Resources', href: '/learn' },
  { name: 'Archive / Past Events', href: '/archive' },
  { name: 'Case Studies', href: '/case-studies' },
  { name: 'Store', href: '/shop' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];

const isLinkActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header class="fixed top-0 left-0 right-0 z-50 px-3 py-2 sm:px-6 sm:py-3 transition-all">
  <div class="max-w-7xl mx-auto bg-white/95 backdrop-blur-md rounded-full px-4 sm:px-6 py-2 flex items-center justify-between shadow-md border-2 border-black">
    
    <!-- Official QShala SVG Logo -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <img
        src="/assets/logos/QShala Logo 1.svg"
        alt="QShala Logo"
        width="130"
        height="36"
        class="h-8 sm:h-9 w-auto object-contain hover:scale-105 transition-transform duration-300"
        loading="eager"
      />
    </a>

    <!-- Desktop Nav Links with Active Route Highlighting & Left-to-Right Animated Underline -->
    <nav class="hidden lg:flex items-center gap-5 font-black text-slate-900 text-xs sm:text-sm font-heading">
      {NAV_LINKS.slice(0, 8).map((link) => {
        const active = isLinkActive(link.href);
        return (
          <a 
            href={link.href} 
            data-astro-prefetch="hover" 
            class={`relative py-1 transition-colors ${
              active 
                ? 'text-[#30B2E7] after:w-full' 
                : 'hover:text-[#30B2E7] after:w-0 hover:after:w-full'
            } after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-0.5 after:bg-[#30B2E7] after:transition-all after:duration-300`}
          >
            {link.name === 'Archive / Past Events' ? 'Archive' : link.name === 'Learn & Resources' ? 'Learn' : link.name}
          </a>
        );
      })}
    </nav>

    <!-- Action CTAs -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href="/book-a-quiz"
        data-astro-prefetch="hover"
        class="px-5 py-2 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-xs sm:text-sm border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] transition-all font-heading"
      >
        Book a Quiz
      </a>
    </div>

    <!-- Mobile Hamburger SVG Icon Button -->
    <button
      id="menuToggleBtn"
      class="lg:hidden w-10 h-10 rounded-full bg-slate-100 text-slate-900 border-2 border-black flex items-center justify-center cursor-pointer shadow-sm hover:bg-slate-200 transition-all shrink-0"
      aria-label="Toggle Mobile Menu"
    >
      <svg class="w-5 h-5 fill-current text-slate-900" viewBox="0 0 24 24">
        <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Panel with Clear Active Page Highlighting -->
  <div
    id="mobileMenu"
    class="hidden lg:hidden mt-2 max-w-7xl mx-auto bg-white rounded-3xl p-5 shadow-2xl border-2 border-black max-h-[85vh] overflow-y-auto"
  >
    <div class="flex flex-col gap-1.5 font-black text-slate-900 font-heading text-sm">
      {NAV_LINKS.map((link) => {
        const active = isLinkActive(link.href);
        return (
          <a
            href={link.href}
            class={`px-4 py-2.5 rounded-2xl flex items-center justify-between transition-all ${
              active
                ? 'bg-[#30B2E7] text-white shadow-md border-2 border-slate-900'
                : 'text-slate-800 hover:bg-slate-100'
            }`}
          >
            <span>{link.name}</span>
            {active && (
              <span class="px-2.5 py-0.5 rounded-full bg-[#FDB913] text-slate-950 font-black text-[10px] uppercase tracking-wider font-heading border border-slate-900 shadow-sm">
                Active Page
              </span>
            )}
          </a>
        );
      })}

      <a
        href="/book-a-quiz"
        class="mt-3 text-center py-3 rounded-2xl bg-[#FDB913] hover:bg-amber-400 text-black font-black border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] uppercase tracking-wider text-xs font-heading"
      >
        Book a Quiz &rarr;
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.getElementById('menuToggleBtn');
    const menu = document.getElementById('mobileMenu');

    toggleBtn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
      if (menu && !menu.classList.contains('hidden')) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    });

    // Ensure scroll unlocks when clicking a link
    const mobileLinks = menu?.querySelectorAll('a');
    mobileLinks?.forEach(link => {
      link.addEventListener('click', () => {
        menu?.classList.add('hidden');
        document.body.style.overflow = '';
      });
    });
  });
</script>
