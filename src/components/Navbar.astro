---
// Pure static HTML Header component for maximum performance
---

<header class="fixed top-0 left-0 right-0 z-50 px-4 py-3 md:px-8 md:py-4 transition-all">
  <div class="max-w-7xl mx-auto bg-white/95 rounded-full px-6 py-2.5 flex items-center justify-between shadow-md border-2 border-black">
    
    <!-- Official QShala SVG Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/assets/logos/QShala Logo 1.svg"
        alt="QShala Logo"
        width="140"
        height="40"
        class="h-10 w-auto object-contain hover:scale-105 transition-transform duration-300"
        loading="eager"
      />
    </a>

    <!-- Desktop Nav Links with Left-to-Right Animated Underline -->
    <nav class="hidden lg:flex items-center gap-6 font-black text-slate-900 text-xs sm:text-sm font-heading">
      <a href="/" data-astro-prefetch="hover" class="relative py-1 hover:text-[#30B2E7] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#30B2E7] hover:after:w-full after:transition-all after:duration-300">Home</a>
      <a href="/about" data-astro-prefetch="hover" class="relative py-1 hover:text-[#30B2E7] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#30B2E7] hover:after:w-full after:transition-all after:duration-300">About Us</a>
      <a href="/services" data-astro-prefetch="hover" class="relative py-1 hover:text-[#30B2E7] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#30B2E7] hover:after:w-full after:transition-all after:duration-300">Services</a>
      <a href="/learn" data-astro-prefetch="hover" class="relative py-1 hover:text-[#30B2E7] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#30B2E7] hover:after:w-full after:transition-all after:duration-300">Learn &amp; Resources</a>
      <a href="/archive" data-astro-prefetch="hover" class="relative py-1 hover:text-[#30B2E7] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#30B2E7] hover:after:w-full after:transition-all after:duration-300">Archive</a>
      <a href="/case-studies" data-astro-prefetch="hover" class="relative py-1 hover:text-[#30B2E7] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#30B2E7] hover:after:w-full after:transition-all after:duration-300">Case Studies</a>
      <a href="/shop" data-astro-prefetch="hover" class="relative py-1 hover:text-[#30B2E7] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#30B2E7] hover:after:w-full after:transition-all after:duration-300">Shop</a>
      <a href="/blog" data-astro-prefetch="hover" class="relative py-1 hover:text-[#30B2E7] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#30B2E7] hover:after:w-full after:transition-all after:duration-300">Blog</a>
    </nav>

    <!-- Action CTAs -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href="/book-a-quiz"
        data-astro-prefetch="hover"
        class="px-5 py-2 rounded-full bg-[#FDB913] hover:bg-amber-400 text-black font-black text-xs sm:text-sm border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] hover:translate-x-[1px] hover:translate-y-[1px] transition-all font-heading"
      >
        Book a Quiz
      </a>
    </div>

    <!-- Mobile Navigation Menu Toggle -->
    <button
      id="menuToggleBtn"
      class="lg:hidden p-2 rounded-full bg-slate-100 text-black border-2 border-black font-bold text-xs px-3"
      aria-label="Toggle Menu"
    >
      Menu
    </button>
  </div>

  <!-- Mobile Dropdown Panel -->
  <div
    id="mobileMenu"
    class="hidden lg:hidden mt-3 max-w-7xl mx-auto bg-white rounded-3xl p-6 shadow-2xl border-2 border-black"
  >
    <div class="flex flex-col gap-3 font-black text-slate-900 font-heading text-sm">
      <a href="/" class="hover:text-[#30B2E7]">Home</a>
      <a href="/about" class="hover:text-[#30B2E7]">About Us</a>
      <a href="/services" class="hover:text-[#30B2E7]">Services</a>
      <a href="/learn" class="hover:text-[#30B2E7]">Learn &amp; Resources</a>
      <a href="/archive" class="hover:text-[#30B2E7]">Archive / Past Events</a>
      <a href="/case-studies" class="hover:text-[#30B2E7]">Case Studies</a>
      <a href="/shop" class="hover:text-[#30B2E7]">Store</a>
      <a href="/blog" class="hover:text-[#30B2E7]">Blog</a>
      <a href="/contact" class="hover:text-[#30B2E7]">Contact</a>
      <a
        href="/book-a-quiz"
        class="mt-2 text-center py-3 rounded-2xl bg-[#FDB913] text-black font-black border-2 border-black shadow-md"
      >
        Book a Quiz
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.getElementById('menuToggleBtn');
    const menu = document.getElementById('mobileMenu');

    toggleBtn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
      if (menu && !menu.classList.contains('hidden')) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    });

    // Ensure scroll unlocks when clicking a link
    const mobileLinks = menu?.querySelectorAll('a');
    mobileLinks?.forEach(link => {
      link.addEventListener('click', () => {
        menu?.classList.add('hidden');
        document.body.style.overflow = '';
      });
    });
  });
</script>
