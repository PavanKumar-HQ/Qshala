---
import { toHTML } from '@portabletext/to-html';
import { getImageUrl } from '../lib/sanity/image';

interface Props {
  value: any;
  class?: string;
}

const { value, class: className = '' } = Astro.props;

let html = '';

if (typeof value === 'string') {
  html = value;
} else if (value && Array.isArray(value)) {
  try {
    html = toHTML(value, {
      components: {
        types: {
          image: ({ value }) => {
            const url = getImageUrl(value);
            const alt = value.alt || 'QShala Content Image';
            const caption = value.caption ? `<figcaption class="text-xs text-slate-500 mt-2 text-center font-medium">${value.caption}</figcaption>` : '';
            return `<figure class="my-6 rounded-2xl overflow-hidden shadow-sm"><img src="${url}" alt="${alt}" class="w-full h-auto object-cover" loading="lazy" />${caption}</figure>`;
          },
        },
        marks: {
          link: ({ children, value }) => {
            const rel = !value.href.startsWith('/') ? 'noreferrer noopener' : undefined;
            const target = value.blank ? '_blank' : undefined;
            return `<a href="${value.href}" rel="${rel || ''}" target="${target || ''}" class="text-[#30B2E7] hover:underline font-bold">${children}</a>`;
          },
        },
      },
    });
  } catch (err) {
    console.warn('[PortableText] Render error:', err);
    html = '';
  }
}
---

<div class={`prose max-w-none ${className}`} set:html={html} />
