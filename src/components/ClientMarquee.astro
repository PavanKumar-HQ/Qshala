---
// ClientMarquee.astro — QShala brand-aligned marquee of clients/partners

const CLIENTS_ROW1 = [
  { name: "Google", category: "Tech", color: "#30B2E7", bg: "#E8F6FD", logo: "google.svg" },
  { name: "HDFC Bank", category: "Finance", color: "#FDB913", bg: "#FFF8E1", logo: "hdfcbank.svg" },
  { name: "Wipro", category: "Tech", color: "#75B543", bg: "#EDF7E5", logo: "wipro.svg" },
  { name: "Microsoft", category: "Tech", color: "#30B2E7", bg: "#E8F6FD", logo: "microsoft.svg" },
  { name: "Tata Group", category: "Enterprise", color: "#FDB913", bg: "#FFF8E1", logo: "tatagroup.svg" },
  { name: "Amazon", category: "E-Commerce", color: "#75B543", bg: "#EDF7E5", logo: "amazon.svg" },
];

const CLIENTS_ROW2 = [
  { name: "Infosys", category: "Tech", color: "#30B2E7", bg: "#E8F6FD", logo: "infosys.svg" },
  { name: "Netflix", category: "Entertainment", color: "#FDB913", bg: "#FFF8E1", logo: "netflix.svg" },
  { name: "Apple", category: "Consumer Tech", color: "#75B543", bg: "#EDF7E5", logo: "apple.svg" },
  { name: "Byju's", category: "EdTech", color: "#30B2E7", bg: "#E8F6FD", logo: "byjus.svg" },
  { name: "Facebook", category: "Social Media", color: "#FDB913", bg: "#FFF8E1", logo: "facebook.svg" },
  { name: "Intel", category: "Hardware", color: "#75B543", bg: "#EDF7E5", logo: "intel.svg" },
];

// Triple-duplicate to ensure seamless looping with no gap
const row1 = [...CLIENTS_ROW1, ...CLIENTS_ROW1, ...CLIENTS_ROW1];
const row2 = [...CLIENTS_ROW2, ...CLIENTS_ROW2, ...CLIENTS_ROW2];
---

<section class="py-20 bg-white border-t-4 border-b-4 border-black overflow-hidden">

  <!-- Header -->
  <div class="max-w-7xl mx-auto px-6 mb-12 text-center">
    <span class="inline-block px-4 py-1.5 rounded-full bg-[#FDB913] text-black font-black text-xs uppercase tracking-wider border-2 border-black shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] font-heading">
      Trusted by the Best
    </span>
    <h2 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight mt-4 font-heading">
      Brands That Choose Curiosity.
    </h2>
    <p class="mt-3 text-slate-600 font-semibold text-base max-w-lg mx-auto leading-relaxed">
      From Fortune 500 companies to India's top-ranked schools — QShala sparks curiosity at scale.
    </p>
  </div>

  <!-- Row 1: Left scroll -->
  <div class="marquee-container mb-4" id="marquee-row-1">
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-32 z-10 bg-gradient-to-r from-white to-transparent"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-32 z-10 bg-gradient-to-l from-white to-transparent"></div>
    <div class="marquee-track scroll-left flex gap-5 w-max">
      {row1.map((client) => (
        <div class="client-card" style={`--accent: ${client.color}; --bg: ${client.bg};`}>
          <div class="client-card-logo-wrapper">
            <div class="client-card-badge">
              {client.name[0]}
            </div>
            <img
              src={`/assets/logos/${client.logo}`}
              alt={`${client.name} logo`}
              class="client-logo"
              style="opacity: 0; transition: opacity 0.2s;"
              loading="lazy"
              onload="this.style.opacity='1';"
            />
          </div>
          <div class="client-card-body">
            <div class="client-card-name">{client.name}</div>
            <div class="client-card-cat">{client.category}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Row 2: Right scroll -->
  <div class="marquee-container" id="marquee-row-2">
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-32 z-10 bg-gradient-to-r from-white to-transparent"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-32 z-10 bg-gradient-to-l from-white to-transparent"></div>
    <div class="marquee-track scroll-right flex gap-5 w-max">
      {row2.map((client) => (
        <div class="client-card" style={`--accent: ${client.color}; --bg: ${client.bg};`}>
          <div class="client-card-logo-wrapper">
            <div class="client-card-badge">
              {client.name[0]}
            </div>
            <img
              src={`/assets/logos/${client.logo}`}
              alt={`${client.name} logo`}
              class="client-logo"
              style="opacity: 0; transition: opacity 0.2s;"
              loading="lazy"
              onload="this.style.opacity='1';"
            />
          </div>
          <div class="client-card-body">
            <div class="client-card-name">{client.name}</div>
            <div class="client-card-cat">{client.category}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Stats strip -->
  <div class="max-w-5xl mx-auto px-6 mt-14">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        { value: "250+", label: "Schools Partnered", color: "#30B2E7", bg: "#E8F6FD" },
        { value: "80+",  label: "Corporate Clients",  color: "#FDB913", bg: "#FFF8E1" },
        { value: "4.9★", label: "Average Rating",     color: "#75B543", bg: "#EDF7E5" },
        { value: "18+",  label: "Cities Covered",     color: "#30B2E7", bg: "#E8F6FD" },
      ].map((stat) => (
        <div
          class="flex flex-col items-center justify-center py-6 px-4 rounded-2xl border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] text-center transition-transform hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]"
          style={`background-color: ${stat.bg};`}
        >
          <span class="text-3xl font-black font-heading" style={`color: ${stat.color}`}>{stat.value}</span>
          <span class="text-[11px] font-black uppercase tracking-wider text-slate-600 mt-1">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Keyframes ── */
  @keyframes scroll-left {
    0%   { transform: translateX(0); }
    100% { transform: translateX(calc(-100% / 3)); }
  }

  @keyframes scroll-right {
    0%   { transform: translateX(calc(-100% / 3)); }
    100% { transform: translateX(0); }
  }

  /* ── Container ── */
  .marquee-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 8px 0;
  }

  /* ── Tracks ── */
  .marquee-track {
    display: flex;
    gap: 20px;
    width: max-content;
    will-change: transform;
  }

  .scroll-left {
    animation: scroll-left 28s linear infinite;
  }

  .scroll-right {
    animation: scroll-right 22s linear infinite;
  }

  /* ── Pause on hover (applied to the container, affects the track inside) ── */
  .marquee-container:hover .scroll-left,
  .marquee-container:hover .scroll-right {
    animation-play-state: paused;
  }

  /* ── Cards ── */
  .client-card {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    border-radius: 18px;
    border: 2.5px solid var(--accent);
    background: var(--bg);
    box-shadow: 4px 4px 0px 0px rgba(0, 0, 0, 0.9);
    min-width: 210px;
    cursor: default;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .client-card:hover {
    transform: translateY(-3px);
    box-shadow: 6px 6px 0px 0px rgba(0, 0, 0, 0.9);
  }

  .client-card-logo-wrapper {
    position: relative;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .client-logo {
    position: absolute;
    inset: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 2px solid black;
    background-color: white;
    object-fit: contain;
    padding: 6px;
    z-index: 10;
    box-sizing: border-box;
  }

  .client-card-badge {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: var(--accent);
    border: 2px solid black;
    font-weight: 900;
    font-size: 18px;
    color: white;
    letter-spacing: -0.5px;
    z-index: 5;
  }

  .client-card-body {
    display: flex;
    flex-direction: column;
  }

  .client-card-name {
    font-weight: 900;
    font-size: 14px;
    color: #0f172a;
    white-space: nowrap;
    line-height: 1.2;
    font-family: var(--font-heading, sans-serif);
  }

  .client-card-cat {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    margin-top: 3px;
  }
</style>
