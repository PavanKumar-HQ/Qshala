---
import '../styles/global.css';
import LoadingScreen from '../components/LoadingScreen';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "QShala | Questions • Quriosity • Quests — India's Curiosity Company",
  description = "Replacing Rote Learning with Curiosity, Socratic Storytelling, Questions, and Wonder. Partnering with 250+ Schools & 80+ Corporates across India."
} = Astro.props;

const siteUrl = 'https://qshala.vercel.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = `${siteUrl}/og-image.jpg?v=9`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#30B2E7" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / WhatsApp / Facebook / LinkedIn / iMessage Link Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="QShala — India's Curiosity Company" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="QShala — India's Curiosity Company" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data for Rich Search Results -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "QShala",
      "url": siteUrl,
      "description": description,
      "sameAs": [
        "https://twitter.com/qshala",
        "https://linkedin.com/company/qshala"
      ]
    })} />
    
    <!-- Self-hosted font preloads for performance -->
    <link rel="preload" href="/fonts/Trustha%20-%20Causten%20Round%20Black.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Trustha%20-%20Causten%20Round%20Regular.otf" as="font" type="font/otf" crossorigin />
    <ViewTransitions />

    <!-- Inline script to prevent FOUC -->
    <script is:inline data-astro-rerun>
      (function() {
        try {
          // Astro ViewTransitions preserves the window object between pages.
          // This ensures the loader only runs on a fresh load or hard reload (F5).
          if (window.hasLoaderShown) {
            document.documentElement.classList.add('skip-loader');
          } else {
            document.documentElement.classList.add('loading-active');
            window.hasLoaderShown = true;
          }
        } catch(e) {}
      })();
    </script>
    <style is:global>
      html.skip-loader #loader-root {
        display: none !important;
      }
      html.loading-active body {
        overflow: hidden;
      }
      html.loading-active body > *:not(#loader-root) {
        opacity: 0 !important;
        visibility: hidden !important;
      }
    </style>
  </head>
  <body class="antialiased bg-[#FFFDF5] text-black min-h-screen flex flex-col font-sans">

    <!-- 5-scene Curiosity Loader -->
    <div id="loader-root">
      <LoadingScreen client:load />
    </div>

    <slot />

    <!-- Pure JS Tab Title Switcher -->
    <script is:inline>
      (function() {
        var originalTitle = document.title;
        var funnyMessages = [
          "QT misses you! Come back!",
          "Still curious? Click back!",
          "Don't leave QT alone with questions!",
          "A wild quiz question appeared!",
          "QT is peeking... Where did you go?"
        ];
        var titleInterval;

        // Ensure we always have the correct title for the current page
        document.addEventListener('astro:page-load', function() {
          if (!document.hidden) {
            originalTitle = document.title;
          }
        });

        document.addEventListener('visibilitychange', function() {
          if (document.hidden) {
            var msg = funnyMessages[Math.floor(Math.random() * funnyMessages.length)];
            document.title = msg;
            
            // Force the title to stay even if React or other scripts try to revert it in the background
            titleInterval = setInterval(function() {
              if (document.title !== msg) document.title = msg;
            }, 1000);
          } else {
            clearInterval(titleInterval);
            document.title = originalTitle;
          }
        });
      })();
    </script>
  </body>
</html>
