---
import '../styles/global.css';
import LoadingScreen from '../components/LoadingScreen';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "QShala | Questions • Quriosity • Quests — India's Curiosity Company",
  description = "Replacing Rote Learning with Curiosity, Socratic Storytelling, Questions, and Wonder. Partnering with 250+ Schools & 80+ Corporates across India.",
  image = "/og-image.jpg"
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : 'https://qshala.vercel.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
// Add cache-busting query parameter ?v=3 to bust WhatsApp/Social scrapers cache
const ogImageUrl = new URL(`${image}?v=3`, siteUrl).href;
const ogGifUrl = new URL(`/og-image.gif?v=3`, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#30B2E7" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph / WhatsApp / Facebook / LinkedIn / iMessage Standalone Mascot Banner -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="QShala — India's Curiosity Company" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content="QShala Official QT Mascot" />

    <!-- Animated GIF Link Preview -->
    <meta property="og:image" content={ogGifUrl} />
    <meta property="og:image:type" content="image/gif" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data for Rich Search Results -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "QShala",
      "url": "https://qshala.vercel.app",
      "logo": ogImageUrl,
      "description": description,
      "sameAs": [
        "https://twitter.com/qshala",
        "https://linkedin.com/company/qshala"
      ]
    })} />
    
    <!-- Self-hosted font preloads for performance -->
    <link rel="preload" href="/fonts/Causten-Round-Black.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Causten-Round.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="antialiased bg-[#FFFDF5] text-black min-h-screen flex flex-col font-sans">

    <!-- 5-scene Curiosity Loader -->
    <LoadingScreen client:only="react" />

    <slot />

    <!-- Pure JS Tab Title Switcher -->
    <script>
      const originalTitle = document.title;
      const funnyMessages = [
        "QT misses you! Come back!",
        "Still curious? Click back!",
        "Don't leave QT alone with questions!",
        "A wild quiz question appeared!",
        "QT is peeking... Where did you go?"
      ];
      document.addEventListener('visibilitychange', () => {
        document.title = document.hidden
          ? funnyMessages[Math.floor(Math.random() * funnyMessages.length)]
          : originalTitle;
      });
    </script>
  </body>
</html>
